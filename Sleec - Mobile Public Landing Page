      btn.disabled = true;

      setTimeout(() => {
        document.getElementById('waitlist-form-container').classList.add('hidden');
        document.getElementById('waitlist-success-container').classList.remove('hidden');
        btn.innerHTML = '<span>Join Waitlist</span><span class="material-symbols-outlined text-[18px]">arrow_forward</span>';
        btn.disabled = false;
      }, 800);
