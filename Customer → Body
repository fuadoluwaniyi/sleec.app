<script>
  function openCustomerDrawer(customerId, addedByStore = true) {
    const drawer = document.getElementById('customer-drawer');
    const backdrop = document.getElementById('drawer-backdrop');
    const panel = document.getElementById('drawer-panel');
    const editBtn = document.getElementById('edit-customer-btn');
    const sourceBadge = document.getElementById('customer-source-badge');
    
    if (addedByStore) {
        editBtn.style.display = 'block';
        sourceBadge.textContent = 'Added by Store';
    } else {
        editBtn.style.display = 'none';
        sourceBadge.textContent = 'Customer Account';
    }
    
    drawer.classList.remove('hidden');
    // small delay for transition
    setTimeout(() => {
      backdrop.classList.remove('opacity-0');
      backdrop.classList.add('opacity-100');
      panel.classList.remove('translate-x-full');
    }, 10);
  }

  function closeCustomerDrawer() {
    const drawer = document.getElementById('customer-drawer');
    const backdrop = document.getElementById('drawer-backdrop');
    const panel = document.getElementById('drawer-panel');
    
    backdrop.classList.remove('opacity-100');
    backdrop.classList.add('opacity-0');
    panel.classList.add('translate-x-full');
    
    setTimeout(() => {
      drawer.classList.add('hidden');
    }, 300); // match transition duration
  }

  function openCreateOrderModal() {
      closeCustomerDrawer();
      document.getElementById('create-order-modal').classList.remove('hidden');
  }

  function toggleMenu(menuId) {
    // hide others first
    document.querySelectorAll('[id^="menu-"]').forEach(el => {
      if(el.id !== menuId) el.classList.add('hidden');
    });
    
    const menu = document.getElementById(menuId);
    if(menu) menu.classList.toggle('hidden');
  }

  // Close menus on outside click
  document.addEventListener('click', (e) => {
    if (!e.target.closest('button[onclick^="toggleMenu"]')) {
      document.querySelectorAll('[id^="menu-"]').forEach(el => el.classList.add('hidden'));
    }
  });
</script></main></div></body></html>
