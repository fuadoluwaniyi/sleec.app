/* Modal & Popover transitions */
.modal-overlay { opacity: 0; pointer-events: none; transition: opacity 0.3s ease; }
.modal-overlay.active { opacity: 1; pointer-events: auto; }
.modal-content { transform: scale(0.95); opacity: 0; transition: all 0.3s ease; }
.modal-overlay.active .modal-content { transform: scale(1); opacity: 1; }

.popover { opacity: 0; pointer-events: none; transform: translateY(-10px); transition: all 0.2s ease; }
.popover.active { opacity: 1; pointer-events: auto; transform: translateY(0); }

