<script>
(function() {
    const modal = document.getElementById('edit-contact-modal');
    const dayButtons = modal.querySelectorAll('#day-selector button');
    const openSelect = document.getElementById('input-open-time');
    const closeSelect = document.getElementById('input-close-time');
    
    // 1. Populate Time Selectors
    function populateTimes(select) {
        const times = [];
        for (let h = 0; h < 24; h++) {
            for (let m = 0; m < 60; m += 30) {
                const hour = h % 12 || 12;
                const ampm = h < 12 ? 'AM' : 'PM';
                const timeStr = `${hour}:${m === 0 ? '00' : '30'} ${ampm}`;
                const option = document.createElement('option');
                option.value = timeStr;
                option.textContent = timeStr;
                select.appendChild(option);
            }
        }
    }
    populateTimes(openSelect);
    populateTimes(closeSelect);

    // 2. Day Toggle Logic
    dayButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            btn.classList.toggle('bg-primary');
            btn.classList.toggle('text-on-primary');
            btn.classList.toggle('border-primary');
        });
    });

    // 3. Persistence: Pre-fill on open
    window.openEditContactModal = function() {
        const section = document.getElementById('contact-support-section');
        const currentHours = section.querySelector('.space-y-sm > div:nth-child(1) span.font-medium').innerText;
        const currentPhone = section.querySelector('.space-y-sm > div:nth-child(2) span.font-medium').innerText;
        const currentWhatsApp = section.querySelector('.space-y-sm > div:nth-child(3) span.font-medium').innerText;
        const currentEmail = section.querySelector('.space-y-sm > div:nth-child(4) span.font-medium').innerText;

        // Parse hours (e.g., "Mon-Sat, 9:00 AM - 6:00 PM")
        const parts = currentHours.split(',');
        if (parts.length === 2) {
            const daysRange = parts[0].trim();
            const timeRange = parts[1].trim().split('-');
            if (timeRange.length === 2) {
                openSelect.value = timeRange[0].trim();
                closeSelect.value = timeRange[1].trim();
            }
        }

        document.getElementById('input-contact-phone').value = currentPhone;
        document.getElementById('input-contact-whatsapp').value = currentWhatsApp;
        document.getElementById('input-contact-email').value = currentEmail;
        
        modal.classList.add('active');
    };

    // 4. Save Changes Logic
    window.saveContactChanges = function() {
        const selectedDays = Array.from(dayButtons)
            .filter(btn => btn.classList.contains('bg-primary'))
            .map(btn => btn.dataset.day);
        
        let dayString = "Mon-Fri";
        if (selectedDays.length > 0) {
            dayString = selectedDays.length > 1 ? `${selectedDays[0]}-${selectedDays[selectedDays.length - 1]}` : selectedDays[0];
        }

        const hoursStr = `${dayString}, ${openSelect.value} - ${closeSelect.value}`;
        const phone = document.getElementById('input-contact-phone').value;
        const whatsapp = document.getElementById('input-contact-whatsapp').value;
        const email = document.getElementById('input-contact-email').value;

        const section = document.getElementById('contact-support-section');
        const rows = section.querySelectorAll('.space-y-sm > div');
        rows[0].querySelector('span.font-medium').innerText = hoursStr;
        rows[1].querySelector('span.font-medium').innerText = phone;
        rows[2].querySelector('span.font-medium').innerText = whatsapp;
        rows[3].querySelector('span.font-medium').innerText = email;

        modal.classList.remove('active');
        if (typeof showToast === 'function') {
            showToast('Contact details updated successfully');
        }
    };
})();
</script>







