                <span class="material-symbols-outlined text-primary opacity-0 group-hover:opacity-100">add_circle</span>
            </button>
        `).join('') : '<p class="text-xs text-on-surface-variant p-sm text-center">No products found</p>';
    };

    window.addFeaturedProduct = function(id) {
        if (featuredIds.length >= 7) { alert('Maximum 7 products allowed'); return; }
        featuredIds.push(id);
        renderFeaturedList();
        document.getElementById('featured-search-results').classList.add('hidden');
        document.getElementById('featured-search-input').value = '';
    };

    window.removeFeaturedProduct = function(id) {
        featuredIds = featuredIds.filter(fid => fid !== id);
        renderFeaturedList();
    };

    window.moveFeatured = function(id, direction) {
        const idx = featuredIds.indexOf(id);
        if (direction === 'up' && idx > 0) {
            [featuredIds[idx], featuredIds[idx-1]] = [featuredIds[idx-1], featuredIds[idx]];
        } else if (direction === 'down' && idx < featuredIds.length - 1) {
            [featuredIds[idx], featuredIds[idx+1]] = [featuredIds[idx+1], featuredIds[idx]];
        }
        renderFeaturedList();
    };

    window.renderFeaturedList = function() {
        const container = document.getElementById('featured-list-items');
        container.innerHTML = featuredIds.map(id => {
            const p = allProducts.find(prod => prod.id === id);
            return `
                <div class="flex items-center justify-between p-sm rounded-xl border border-outline-variant/30 bg-surface-container-low group">
                    <div class="flex items-center gap-md">
                        ${p.img ? `<img class="w-10 h-10 rounded object-cover" src="${p.img}">` : `<div class="w-10 h-10 rounded bg-surface-container-high flex items-center justify-center"><span class="material-symbols-outlined text-outline-variant text-[20px]">${p.icon}</span></div>`}
                        <div>
