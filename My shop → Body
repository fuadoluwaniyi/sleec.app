        } else if (type === 'Kitchen') {
            document.getElementById('store-name-display').innerHTML = 'Hearth & Home <span id="main-profile-verified-icon" class="material-symbols-outlined text-primary text-[24px] ' + (window.verificationState === 'verified' ? '' : 'hidden') + '">check_circle</span>';
            document.getElementById('store-handle-display').innerText = '@hearthandhome';
            document.getElementById('store-bio-display').innerText = 'Artisanal kitchenware and home goods designed for slow living and mindful cooking.';
        } else if (type === 'Beauty') {
            document.getElementById('store-name-display').innerHTML = 'Glow Studio <span id="main-profile-verified-icon" class="material-symbols-outlined text-primary text-[24px] ' + (window.verificationState === 'verified' ? '' : 'hidden') + '">check_circle</span>';
            document.getElementById('store-handle-display').innerText = '@glowstudio';
            document.getElementById('store-bio-display').innerText = 'Clean, cruelty-free skincare and cosmetics for your daily routine.';
        }
    }

    function toggleSharePopover() {
        const popover = document.getElementById('share-popover');
        popover.classList.toggle('active');
    }

    // Close popover when clicking outside
    document.addEventListener('click', function(event) {
        const popover = document.getElementById('share-popover');
        const btn = document.getElementById('btn-share-shop');
        if (!btn.contains(event.target) && !popover.contains(event.target)) {
            popover.classList.remove('active');
        }
    });

    function openPreviewModal() {
        document.getElementById('preview-modal').classList.add('active');
        document.body.style.overflow = 'hidden'; // Prevent background scrolling
    }

    function closePreviewModal(force) {
        if (force === true || event.target.id === 'preview-modal') {
            document.getElementById('preview-modal').classList.remove('active');
            document.body.style.overflow = '';
        }
    }

    function switchPreviewMode(mode) {
        const btnMobile = document.getElementById('btn-preview-mobile');
        const btnDesktop = document.getElementById('btn-preview-desktop');
        const frameMobile = document.getElementById('preview-frame-mobile');
        const frameDesktop = document.getElementById('preview-frame-desktop');

        if (mode === 'mobile') {
            btnMobile.classList.add('bg-surface', 'shadow-sm', 'text-on-surface');
            btnMobile.classList.remove('text-on-surface-variant');
            btnDesktop.classList.remove('bg-surface', 'shadow-sm', 'text-on-surface');
            btnDesktop.classList.add('text-on-surface-variant');
            
            frameMobile.classList.remove('hidden');
            frameDesktop.classList.add('hidden');
        } else {
            btnDesktop.classList.add('bg-surface', 'shadow-sm', 'text-on-surface');
            btnDesktop.classList.remove('text-on-surface-variant');
            btnMobile.classList.remove('bg-surface', 'shadow-sm', 'text-on-surface');
            btnMobile.classList.add('text-on-surface-variant');
            
            frameDesktop.classList.remove('hidden');
            frameMobile.classList.add('hidden');
        }
    }
    
    // Toast Notification System
    function showToast(message) {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = 'toast';
        toast.innerHTML = `<span class="material-symbols-outlined text-primary text-[20px]">check_circle</span> ${message}`;
        container.appendChild(toast);
        
        // Trigger reflow to ensure animation runs
        toast.offsetHeight; 
        
        toast.classList.add('show');
        
        setTimeout(() => {
            toast.classList.remove('show');
            setTimeout(() => {
                container.removeChild(toast);
            }, 300);
        }, 3000);
    }
</script>
