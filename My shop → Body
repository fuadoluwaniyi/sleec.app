            <span class="font-medium bg-surface-container-high py-xs px-sm rounded-md text-on-surface" id="store-handle-display">${handle}</span>
            <span class="flex items-center gap-xs"><span class="material-symbols-outlined text-[16px]">category</span> ${category}</span>
