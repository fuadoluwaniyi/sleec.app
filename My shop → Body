    window.filterFeaturedSearch = function(query) {
        const list = document.getElementById('featured-search-list');
        const filtered = allProducts.filter(p => p.name.toLowerCase().includes(query.toLowerCase()) && !featuredIds.includes(p.id));
        
        list.innerHTML = filtered.length ? filtered.map(p => `
            <button class="w-full flex items-center gap-md p-sm rounded-xl hover:bg-surface-container-high transition-colors text-left group" onclick="addFeaturedProduct('${p.id}')">
