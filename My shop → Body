        btnGetVerified.classList.remove('hidden');
    } else if (window.verificationState === 'pending') {
        btnPending.classList.remove('hidden');
    } else if (window.verificationState === 'verified') {
        statusVerified.classList.remove('hidden');
        if (mainProfileVerifiedIcon) {
            mainProfileVerifiedIcon.classList.remove('hidden');
        }
    }
}

function openVerificationForm() {
    if (window.verificationState === 'not_verified') {
        document.getElementById('verification-form-modal').classList.add('active');
    }
}

function submitVerification() {
    closeModal('verification-form-modal');
    window.verificationState = 'pending';
    updateVerificationUI();
    showToast("Verification submitted successfully");
    document.getElementById('verification-success-modal').classList.add('active');
    
    // Simulate delay to transition to verified
    setTimeout(() => {
        if (window.verificationState === 'pending') {
            window.verificationState = 'verified';
            updateVerificationUI();
            
            // Also update the store profile display if it was saved before verification completed
            saveProfileChanges(true); 
        }
    }, 5000);
}

function showVerificationPendingMessage() {
    document.getElementById('verification-success-modal').classList.add('active');
}

function openEditProfileModal() {
    updateVerificationUI();
    const modal = document.getElementById('edit-profile-modal');
    if (modal) modal.classList.add('active');
}

function openEditHeaderModal() {
    const modal = document.getElementById('edit-header-modal');
    if (modal) modal.classList.add('active');
}

function closeModal(id) {
    const modal = document.getElementById(id);
    if (modal) modal.classList.remove('active');
}

function saveProfileChanges(silent = false) {
    const name = document.getElementById('input-store-name')?.value || 'Jameson Goods';
