    const website = document.getElementById('input-store-website')?.value || 'jamesongoods.com';
    const isVerified = window.verificationState === 'verified';

    let verifiedIconHtml = isVerified ? `<span id="main-profile-verified-icon" class="material-symbols-outlined text-primary text-[24px]">check_circle</span>` : `<span id="main-profile-verified-icon" class="material-symbols-outlined text-primary text-[24px] hidden">check_circle</span>`;

    document.getElementById('store-name-display').innerHTML = `${name} ${verifiedIconHtml}`;
