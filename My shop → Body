                        <button class="p-xs hover:bg-surface-container-highest rounded" onclick="moveFeatured('${p.id}', 'down')"><span class="material-symbols-outlined text-[18px]">arrow_downward</span></button>
                        <button class="p-xs text-primary group/check relative" onclick="removeFeaturedProduct('${p.id}')">
                            <span class="material-symbols-outlined text-[20px] group-hover/check:hidden">check_circle</span>
                            <span class="material-symbols-outlined text-[20px] hidden group-hover/check:block text-error">cancel</span>
                        </button>
                    </div>
                </div>
            `;
        }).join('');
    };

    window.saveFeaturedList = function() {
        const storefrontContainer = document.querySelector('section.space-y-md:nth-of-type(3) > div.flex.gap-md');
        storefrontContainer.innerHTML = featuredIds.map(id => {
            const p = allProducts.find(prod => prod.id === id);
            return `
                <div class="bg-surface-container-lowest rounded-xl p-sm shadow-sm border border-outline-variant/30 group relative cursor-pointer w-64 shrink-0">
                    <div class="w-full aspect-square bg-surface-container-high rounded-lg mb-sm ${p.img ? 'bg-cover bg-center' : 'flex items-center justify-center'} relative" ${p.img ? `style="background-image: url('${p.img}')"` : ''}>
                        ${p.img ? '' : `<span class="material-symbols-outlined text-outline-variant text-[48px]">${p.icon}</span>`}
                        <span class="absolute top-2 left-2 ${p.stock === 'In Stock' ? 'bg-primary text-on-primary' : p.stock === 'Low Stock' ? 'bg-surface-container-low text-on-surface-variant border border-outline-variant/50' : 'bg-error text-on-error'} text-[10px] font-bold px-2 py-1 rounded-full uppercase tracking-wide">${p.stock}</span>
                    </div>
                    <p class="text-label-md font-semibold text-on-surface truncate">${p.name}</p>
                    <div class="flex items-center justify-between mt-xs">
                        <p class="text-label-md font-medium text-on-surface-variant">${p.price}</p>
                        <div class="flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px] text-yellow-500" style="font-variation-settings: 'FILL' 1;">star</span>
                            <span class="text-xs font-medium text-on-surface">4.9</span>
                            <span class="text-xs text-on-surface-variant">(24)</span>
                        </div>
                    </div>
                </div>
            `;
        }).join('');
        
        closeModal('manage-featured-modal');
        showToast('Featured products updated');
    };

    document.addEventListener('click', function(e) {
        const results = document.getElementById('featured-search-results');
        const input = document.getElementById('featured-search-input');
        if (results && !results.contains(e.target) && e.target !== input) {
            results.classList.add('hidden');
        }
    });

    // Initial render
    renderFeaturedList();
})();
</script>
