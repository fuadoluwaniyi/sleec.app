        'JAMESO-ORD-401': { status: 'Awaiting Processing', fulfillment: 'Seller Delivery' },
        'JAMESO-ORD-400': { status: 'Out for Delivery', fulfillment: 'Third-Party' }
    };
    
    let summaryCounts = { awaiting: 8, ready: 5, out: 6, completed: 23 };

    function toggleStatusActionMenu(orderId) {
        document.querySelectorAll('[id^="status-menu-"]').forEach(el => {
            if (el.id !== `status-menu-${orderId}`) el.classList.add('hidden');
            else el.classList.toggle('hidden');
        });
    }

    // Close menus when clicking outside
    document.addEventListener('click', () => {
        document.querySelectorAll('[id^="status-menu-"]').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('[id^="more-menu-"]').forEach(el => {
            el.classList.add('hidden');
            el.classList.remove('flex');
        });
    });

    function updateOrderStatus(orderId, newStatus, newClasses) {
        ordersData[orderId].status = newStatus;
        const badge = document.getElementById(`status-badge-${orderId}`);
        if(badge) {
            badge.innerText = newStatus;
            badge.className = `inline-flex items-center px-2.5 py-1 rounded-full ${newClasses} font-label-sm text-label-sm justify-center transition-colors cursor-pointer`;
        }
        
        // Update summary counts (Demo Logic)
        if (newStatus === 'Completed') {
            summaryCounts.completed++;
            if(ordersData[orderId].fulfillment === 'Pickup') summaryCounts.ready--;
            else if(ordersData[orderId].fulfillment === 'Third-Party') summaryCounts.out--;
        } else if (newStatus === 'Processing') {
            summaryCounts.awaiting--;
        }
        updateSummaryCards();
    }

    function updateSummaryCards() {
        document.getElementById('awaiting-orders-count').innerText = summaryCounts.awaiting;
        document.getElementById('ready-orders-count').innerText = summaryCounts.ready;
        document.getElementById('out-orders-count').innerText = summaryCounts.out;
        document.getElementById('completed-orders-count').innerText = summaryCounts.completed;
        
        // Dummy progress bar updates
        document.getElementById('awaiting-progress').style.width = (summaryCounts.awaiting * 3) + '%';
        document.getElementById('ready-progress').style.width = (summaryCounts.ready * 4) + '%';
        document.getElementById('out-progress').style.width = (summaryCounts.out * 3) + '%';
        document.getElementById('completed-progress').style.width = (summaryCounts.completed * 2) + '%';
    }

    function openOrderDrawer(orderId, customerName, fulfillment, status, amount, date) {
        document.getElementById('drawer-order-id').innerText = orderId;
        document.getElementById('drawer-customer-name').innerText = customerName;
        document.getElementById('drawer-customer-initials').innerText = customerName.split(' ').map(n=>n[0]).join('');
        document.getElementById('drawer-order-status').innerText = ordersData[orderId].status || status;
        document.getElementById('drawer-order-amount').innerText = amount;
        document.getElementById('drawer-subtotal').innerText = amount;
        document.getElementById('drawer-total').innerText = amount;
        document.getElementById('drawer-order-date').innerText = 'Placed ' + date;
        
        const typeTitle = document.getElementById('drawer-fulfillment-type-title');
        const fIcon = document.getElementById('drawer-fulfillment-icon');
        const fStatus = document.getElementById('drawer-fulfillment-status');
        const fDesc = document.getElementById('drawer-fulfillment-desc');
        const primaryBtn = document.getElementById('drawer-primary-action');
        const timeline = document.getElementById('drawer-timeline');

