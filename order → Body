            fIcon.className = 'w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center text-secondary shrink-0';
            fStatus.innerText = 'Store Pickup Selected';
            fDesc.innerText = 'Customer intends to pick up from Main Store (Lagos).';
            document.getElementById('drawer-delivery-fee').innerText = '₦0';
            primaryBtn.innerText = 'Confirm Customer Pickup';
            primaryBtn.onclick = () => document.getElementById('pickup-modal').classList.remove('hidden');
            
            timeline.innerHTML = `
                <div class="relative pl-6 pb-md border-l border-outline-variant/30">
                    <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-surface-container-lowest"></div>
                    <p class="font-label-md text-label-md text-on-surface">Ready for Pickup</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">12:30 PM</p>
                </div>
                <div class="relative pl-6 pb-md border-l border-outline-variant/30">
                    <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-surface-container-lowest"></div>
                    <p class="font-label-md text-label-md text-on-surface">Processing Started</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">11:05 AM</p>
                </div>
                <div class="relative pl-6 pb-md border-l border-outline-variant/30">
                    <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-surface-container-lowest"></div>
                    <p class="font-label-md text-label-md text-on-surface">Accepted</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">11:00 AM</p>
                </div>
                <div class="relative pl-6 border-transparent">
                    <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-surface-container-lowest"></div>
                    <p class="font-label-md text-label-md text-on-surface">Order Received</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">10:42 AM</p>
                </div>
            `;
        } else if (fulfillment === 'Seller Delivery') {
            typeTitle.innerText = 'Fulfillment: Delivery';
            fIcon.innerHTML = '<span class="material-symbols-outlined text-[20px]">two_wheeler</span>';
            fIcon.className = 'w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0';
            fStatus.innerText = 'Seller Delivery';
            fDesc.innerText = 'Deliver to: 123 Main St, Lagos';
            document.getElementById('drawer-delivery-fee').innerText = '₦4,000';
            primaryBtn.innerText = 'Accept Order';
            primaryBtn.onclick = () => {
                updateOrderStatus(orderId, 'Processing', 'bg-tertiary-container/30 text-on-tertiary-container');
                closeOrderDrawer();
            };

            timeline.innerHTML = `
                <div class="relative pl-6 border-transparent">
                    <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-surface-container-lowest"></div>
                    <p class="font-label-md text-label-md text-on-surface">Order Received</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">4:15 PM</p>
                </div>
            `;
        } else {
             typeTitle.innerText = 'Fulfillment: 3rd Party';
            fIcon.innerHTML = '<span class="material-symbols-outlined text-[20px]">local_shipping</span>';
            fIcon.className = 'w-10 h-10 rounded-full bg-tertiary/10 flex items-center justify-center text-tertiary shrink-0';
            fStatus.innerText = 'Out for Delivery';
            fDesc.innerText = 'Courier: LogisticsCo';
            document.getElementById('drawer-delivery-fee').innerText = '₦2,500';
            primaryBtn.innerText = 'Mark Delivered';
            primaryBtn.onclick = () => {
                updateOrderStatus(orderId, 'Completed', 'bg-primary/20 text-on-primary-fixed');
                closeOrderDrawer();
            };

            timeline.innerHTML = `
                <div class="relative pl-6 pb-md border-l border-outline-variant/30">
                    <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-tertiary border-2 border-surface-container-lowest"></div>
                    <p class="font-label-md text-label-md text-on-surface">Out for Delivery</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">8:00 AM</p>
                </div>
                <div class="relative pl-6 pb-md border-l border-outline-variant/30">
                    <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-tertiary border-2 border-surface-container-lowest"></div>
                    <p class="font-label-md text-label-md text-on-surface">Picked Up by Third Party</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">7:30 AM</p>
                </div>
                <div class="relative pl-6 pb-md border-l border-outline-variant/30">
                    <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-tertiary border-2 border-surface-container-lowest"></div>
                    <p class="font-label-md text-label-md text-on-surface">Ready for Delivery</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">Yesterday, 5:00 PM</p>
                </div>
                <div class="relative pl-6 pb-md border-l border-outline-variant/30">
                    <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-tertiary border-2 border-surface-container-lowest"></div>
                    <p class="font-label-md text-label-md text-on-surface">Processing</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">Yesterday, 10:00 AM</p>
                </div>
                <div class="relative pl-6 pb-md border-l border-outline-variant/30">
                    <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-tertiary border-2 border-surface-container-lowest"></div>
                    <p class="font-label-md text-label-md text-on-surface">Accepted</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">Yesterday, 9:45 AM</p>
                </div>
                 <div class="relative pl-6 border-transparent">
                    <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-tertiary border-2 border-surface-container-lowest"></div>
                    <p class="font-label-md text-label-md text-on-surface">Order Received</p>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">Yesterday, 9:30 AM</p>
                </div>
            `;
        }

        document.getElementById('order-drawer').classList.remove('translate-x-full');
        document.getElementById('drawer-overlay').classList.remove('hidden', 'opacity-0');
        document.getElementById('drawer-overlay').classList.add('opacity-100');
    }

    function closeOrderDrawer() {
        document.getElementById('order-drawer').classList.add('translate-x-full');
        setTimeout(() => { 
            document.getElementById('drawer-overlay').classList.add('hidden'); 
            document.getElementById('drawer-overlay').classList.remove('opacity-100'); 
        }, 300);
    }
</script>
</body></html>
