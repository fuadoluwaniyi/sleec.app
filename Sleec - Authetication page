<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Sleec - Authentication</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
  tailwind.config = {
    darkMode: "class",
    theme: {
      extend: {
        colors: {
          "primary": "#728156",
          "primary-container": "#6b7a50",
          "primary-hover": "#5f6c47",
          "secondary": "#55633e",
          "secondary-container": "#d9e9b9",
          "surface": "#f8f9f6",
          "surface-container-lowest": "#ffffff",
          "surface-container-low": "#eff4ff",
          "surface-container": "#f4f5f1",
          "surface-container-high": "#e8e9e4",
          "surface-container-highest": "#e2e3df",
          "outline": "#76786d",
          "outline-variant": "#e2e4db",
          "on-surface": "#1a1c18",
          "on-surface-variant": "#45483e",
          "on-primary": "#ffffff",
          "error": "#ba1a1a",
          "error-container": "#ffdad6",
          "on-error": "#ffffff",
          "success": "#2e7d32",
          "success-container": "#dcfce7"
        },
        fontFamily: {
          sans: ["Plus Jakarta Sans", "Inter", "sans-serif"]
        }
      }
    }
  }
</script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Plus+Jakarta+Sans:wght@500;600;700;800&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<style>
  body {
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    background-color: #f8f9f6;
    color: #1a1c18;
    overflow-x: hidden;
  }
  .otp-input:focus {
    border-color: #728156;
    box-shadow: 0 0 0 2px rgba(114, 129, 86, 0.2);
  }
  .role-card.active {
    border-color: #728156;
    background-color: #f4f6f0;
    box-shadow: 0 4px 14px -2px rgba(114, 129, 86, 0.15);
  }
  .role-card.active .role-radio {
    border-color: #728156;
    background-color: #728156;
  }
  .role-card.active .role-radio::after {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    background: white;
    border-radius: 9999px;
  }
  .pill-badge {
    transition: all 0.2s ease;
  }
  .pill-badge.selected {
    background-color: #728156;
    color: #ffffff;
    border-color: #728156;
  }

  /* Floating background commerce elements animation */
  @keyframes floatSlow1 {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-16px) rotate(1deg); }
  }
  @keyframes floatSlow2 {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(14px) rotate(-1.5deg); }
  }
  @keyframes floatSlow3 {
    0%, 100% { transform: translateY(0px) scale(1); }
    50% { transform: translateY(-12px) scale(1.03); }
  }
  @keyframes pulseGlow {
    0%, 100% { opacity: 0.35; transform: scale(1); }
    50% { opacity: 0.65; transform: scale(1.05); }
  }

  .floating-element-1 {
    animation: floatSlow1 7.5s ease-in-out infinite;
  }
  .floating-element-2 {
    animation: floatSlow2 8.5s ease-in-out infinite;
  }
  .floating-element-3 {
    animation: floatSlow3 6.8s ease-in-out infinite;
  }
  .floating-element-4 {
    animation: floatSlow1 9.2s ease-in-out infinite 1.2s;
  }
  .floating-element-5 {
    animation: floatSlow2 7.8s ease-in-out infinite 0.8s;
  }
  .ambient-particle {
    animation: pulseGlow 4s ease-in-out infinite;
  }
</style>
</head>
<body class="min-h-screen flex flex-col justify-between bg-surface selection:bg-secondary-container relative overflow-x-hidden">
<!-- ================= BACKGROUND FLOATING COMMERCE CANVAS ================= -->
<div aria-hidden="true" class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
<!-- Ambient subtle glow spots -->
<div class="absolute -top-24 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl ambient-particle"></div>
<div class="absolute bottom-10 right-1/4 w-[28rem] h-[28rem] bg-secondary-container/20 rounded-full blur-3xl ambient-particle" style="animation-delay: 2s;"></div>
<!-- Floating Item 1: Top-Left New Order Pill -->
<div class="absolute top-28 left-4 lg:left-14 xl:left-24 floating-element-1 opacity-45 sm:opacity-65 transition-all">
<div class="flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-white/85 backdrop-blur-md border border-outline-variant/60 shadow-sm text-xs">
<div class="w-7 h-7 rounded-lg bg-emerald-50 text-success flex items-center justify-center font-bold">
<span class="material-symbols-outlined text-[16px]">shopping_cart_checkout</span>
</div>
<div>
<div class="font-bold text-on-surface text-[12px] flex items-center gap-1.5">
<span>New Order #8921</span>
<span class="w-1.5 h-1.5 rounded-full bg-success"></span>
</div>
<span class="text-primary font-bold text-[11px]">₦45,000</span>
</div>
</div>
</div>
<!-- Floating Item 2: Top-Right Today's Sales Card -->
<div class="absolute top-32 right-4 lg:right-12 xl:right-24 floating-element-2 opacity-40 sm:opacity-60 transition-all">
<div class="p-3.5 rounded-2xl bg-white/85 backdrop-blur-md border border-outline-variant/60 shadow-sm text-xs w-48 space-y-1">
<div class="flex items-center justify-between text-[11px] text-on-surface-variant font-medium">
<span>Today's Sales</span>
<span class="text-success font-semibold flex items-center text-[10px] bg-success-container/70 px-1.5 py-0.5 rounded-md">
<span class="material-symbols-outlined text-[11px]">trending_up</span> +12.5%
          </span>
</div>
<p class="text-sm font-extrabold text-on-surface tracking-tight">₦452,500</p>
<!-- Mini sparkline SVG -->
<svg class="w-full h-5 stroke-primary fill-none pt-1" viewbox="0 0 100 20">
<path d="M0 16 Q 18 14, 32 8 T 65 11 T 100 3" stroke-linecap="round" stroke-width="2"></path>
</svg>
</div>
</div>
<!-- Floating Item 3: Bottom-Left Product Inventory Card (below/beside card) -->
<div class="absolute bottom-28 left-4 lg:left-16 xl:left-28 floating-element-3 opacity-45 sm:opacity-65 transition-all">
<div class="flex items-center gap-3 px-3.5 py-2.5 rounded-2xl bg-white/85 backdrop-blur-md border border-outline-variant/60 shadow-sm text-xs">
<div class="w-9 h-9 rounded-xl bg-surface-container flex items-center justify-center text-primary text-[18px]">
<span class="material-symbols-outlined text-[20px]">coffee</span>
</div>
<div>
<p class="font-bold text-on-surface text-[12px]">Ceramic Mug Set</p>
<div class="flex items-center gap-1.5 text-[11px] text-outline">
<span class="w-1.5 h-1.5 rounded-full bg-success"></span>
<span class="font-medium text-on-surface-variant">In Stock • 24 units</span>
</div>
</div>
</div>
</div>
<!-- Floating Item 4: Bottom-Right Payment Received Notification -->
<div class="absolute bottom-32 right-4 lg:right-16 xl:right-28 floating-element-4 opacity-45 sm:opacity-65 transition-all">
<div class="flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-white/85 backdrop-blur-md border border-outline-variant/60 shadow-sm text-xs">
<div class="w-7 h-7 rounded-full bg-secondary-container text-primary flex items-center justify-center font-bold">
<span class="material-symbols-outlined text-[16px]">verified</span>
</div>
<div>
<p class="font-bold text-on-surface text-[12px]">Payment Received</p>
<p class="text-[11px] text-primary font-bold">₦18,500 <span class="text-outline font-normal">• Instant Settlement</span></p>
</div>
</div>
</div>
<!-- Floating Item 5: Center-Left Customers metric pill -->
<div class="hidden xl:flex absolute top-1/2 left-8 -translate-y-1/2 floating-element-5 opacity-40 items-center gap-2 px-3.5 py-2 rounded-full bg-white/80 backdrop-blur-md border border-outline-variant/50 shadow-sm text-xs font-semibold text-on-surface">
<span class="material-symbols-outlined text-[16px] text-primary">groups</span>
<span>128 Customers</span>
</div>
<!-- Floating Item 6: Center-Right Storefront Badge -->
<div class="hidden xl:flex absolute top-1/2 right-8 -translate-y-1/2 floating-element-1 opacity-40 items-center gap-2 px-3.5 py-2 rounded-full bg-white/80 backdrop-blur-md border border-outline-variant/50 shadow-sm text-xs font-semibold text-on-surface">
<span class="material-symbols-outlined text-[16px] text-secondary">store</span>
<span>sleec.app/shop</span>
</div>
</div>
<!-- Top Header Navigation -->
<header class="w-full h-20 px-6 sm:px-12 flex items-center justify-between border-b border-outline-variant/30 bg-surface/90 backdrop-blur-md sticky top-0 z-30">
<div class="flex items-center gap-3 cursor-pointer" onclick="goToView('entry')">
<div class="w-10 h-10 rounded-xl bg-primary text-on-primary flex items-center justify-center font-bold text-xl shadow-sm">
<span class="material-symbols-outlined text-[24px]">eco</span>
</div>
<span class="text-2xl font-extrabold tracking-tight text-on-surface">Sleec</span>
</div>
<div class="flex items-center gap-4 text-sm font-medium">
<span class="text-on-surface-variant hidden sm:inline" id="top-help-text">Need assistance?</span>
<button class="text-primary hover:underline font-semibold flex items-center gap-1" onclick="showToast('Support team: support@sleec.app')">
<span class="material-symbols-outlined text-[18px]">help</span> Help
      </button>
</div>
</header>
<!-- Main Content Flow Container -->
<main class="flex-1 flex items-center justify-center p-4 sm:p-8 relative z-10">
<div class="w-full max-w-xl bg-surface-container-lowest rounded-2xl border border-outline-variant/40 shadow-[0_8px_30px_rgb(0,0,0,0.04)] p-6 sm:p-10 relative overflow-hidden transition-all duration-300">
<!-- Back button (for secondary views) -->
<button class="hidden mb-6 flex items-center gap-1.5 text-xs font-semibold text-on-surface-variant hover:text-primary transition-colors" id="back-nav-btn" onclick="handleBackNav()">
<span class="material-symbols-outlined text-[18px]">arrow_back</span> Back
      </button>
<!-- VIEW 1: AUTHENTICATION ENTRY (Role & Intent Selection) -->
<section class="space-y-6" id="view-entry">
<div class="text-center space-y-2">
<div class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-secondary-container/40 text-secondary text-xs font-semibold uppercase tracking-wider mb-1">
<span class="material-symbols-outlined text-[14px]">lock_open</span> Early Access Portal
          </div>
<h1 class="text-3xl sm:text-4xl font-extrabold text-on-surface tracking-tight">Welcome to Sleec</h1>
<p class="text-on-surface-variant text-sm sm:text-base max-w-md mx-auto">The simpler way to sell, manage and grow your commerce.</p>
</div>
<div class="space-y-3 pt-2">
<p class="text-xs font-bold uppercase tracking-wider text-outline">Select your primary role</p>
<!-- Seller Option -->
<div class="role-card active p-4 sm:p-5 rounded-xl border-2 border-primary bg-[#f4f6f0] cursor-pointer flex items-center justify-between transition-all" id="role-seller" onclick="selectRole('seller')">
<div class="flex items-center gap-4">
<div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
<span class="material-symbols-outlined text-[28px]">storefront</span>
</div>
<div>
<h3 class="font-bold text-base sm:text-lg text-on-surface">Seller</h3>
<p class="text-xs sm:text-sm text-on-surface-variant">I want to sell, manage orders &amp; grow my shop</p>
</div>
</div>
<div class="w-5 h-5 rounded-full border-2 border-primary flex items-center justify-center role-radio shrink-0"></div>
</div>
<!-- Buyer Option -->
<div class="role-card p-4 sm:p-5 rounded-xl border-2 border-outline-variant/60 bg-surface-container-lowest cursor-pointer flex items-center justify-between hover:border-primary/40 transition-all" id="role-buyer" onclick="selectRole('buyer')">
<div class="flex items-center gap-4">
<div class="w-12 h-12 rounded-xl bg-surface-container text-on-surface-variant flex items-center justify-center shrink-0">
<span class="material-symbols-outlined text-[28px]">shopping_bag</span>
</div>
<div>
<h3 class="font-bold text-base sm:text-lg text-on-surface">Buyer</h3>
<p class="text-xs sm:text-sm text-on-surface-variant">I want to discover and shop with Sleec merchants</p>
</div>
</div>
<div class="w-5 h-5 rounded-full border-2 border-outline-variant flex items-center justify-center role-radio shrink-0"></div>
</div>
</div>
<!-- Primary Action buttons -->
<div class="space-y-3 pt-2">
<button class="w-full py-3.5 px-6 rounded-xl bg-primary hover:bg-primary-hover text-on-primary font-bold text-sm sm:text-base shadow-sm hover:shadow transition-all flex items-center justify-center gap-2" onclick="startRegistrationFlow()">
<span>Create Account</span>
<span class="material-symbols-outlined text-[20px]">arrow_forward</span>
</button>
<button class="w-full py-3.5 px-6 rounded-xl bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-semibold text-sm sm:text-base transition-all" onclick="startLoginFlow()">
            Log In to Existing Account
          </button>
</div>
<p class="text-center text-xs text-on-surface-variant pt-2">
          By continuing, you agree to Sleec's <a class="text-primary underline" href="#">Terms</a> and <a class="text-primary underline" href="#">Privacy Policy</a>.
        </p>
</section>
<!-- VIEW 2: SELLER REGISTRATION (Multi-step) -->
<section class="hidden space-y-6" id="view-seller-register">
<!-- Progress Stepper -->
<div>
<div class="flex items-center justify-between mb-2">
<span class="text-xs font-bold uppercase tracking-wider text-primary" id="seller-step-label">Step 1 of 4: Account Details</span>
<span class="text-xs font-medium text-on-surface-variant" id="seller-step-pct">25%</span>
</div>
<div class="w-full h-1.5 bg-surface-container rounded-full overflow-hidden">
<div class="h-full bg-primary transition-all duration-300 w-1/4" id="seller-progress-bar"></div>
</div>
</div>
<!-- Seller Step 1: Account -->
<div class="space-y-5" id="seller-step-1">
<div>
<h2 class="text-2xl font-bold text-on-surface">Create your Seller account</h2>
<p class="text-xs text-on-surface-variant mt-1.5">Start your 14-day free trial on Sleec.</p>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<div>
<label class="block text-xs font-bold text-on-surface mb-1.5">First Name *</label>
<input class="w-full px-3.5 py-2.5 rounded-lg border border-outline-variant/60 bg-surface-container-low/40 text-sm focus:border-primary focus:bg-white outline-none transition-colors" id="seller-fn" placeholder="Jameson" type="text"/>
<span class="text-[11px] text-error hidden mt-1" id="err-seller-fn">First name is required.</span>
</div>
<div>
<label class="block text-xs font-bold text-on-surface mb-1.5">Last Name *</label>
<input class="w-full px-3.5 py-2.5 rounded-lg border border-outline-variant/60 bg-surface-container-low/40 text-sm focus:border-primary focus:bg-white outline-none transition-colors" id="seller-ln" placeholder="Okoro" type="text"/>
<span class="text-[11px] text-error hidden mt-1" id="err-seller-ln">Last name is required.</span>
</div>
</div>
<div>
<label class="block text-xs font-bold text-on-surface mb-1.5">Email Address *</label>
<input class="w-full px-3.5 py-2.5 rounded-lg border border-outline-variant/60 bg-surface-container-low/40 text-sm focus:border-primary focus:bg-white outline-none transition-colors" id="seller-email" placeholder="jameson@sleecstore.com" type="email"/>
<span class="text-[11px] text-error hidden mt-1" id="err-seller-email">Please enter a valid email address.</span>
</div>
<div>
<label class="block text-xs font-bold text-on-surface mb-1.5">Phone Number *</label>
<div class="flex gap-2">
<select class="px-2.5 py-2.5 rounded-lg border border-outline-variant/60 bg-surface-container-low/40 text-xs font-semibold outline-none" id="seller-phone-code">
<option value="+234">🇳🇬 +234</option>
<option value="+254">🇰🇪 +254</option>
<option value="+233">🇬🇭 +233</option>
<option value="+27">🇿🇦 +27</option>
<option value="+44">🇬🇧 +44</option>
<option value="+1">🇺🇸 +1</option>
</select>
<input class="flex-1 px-3.5 py-2.5 rounded-lg border border-outline-variant/60 bg-surface-container-low/40 text-sm focus:border-primary focus:bg-white outline-none" id="seller-phone" placeholder="801 234 5678" type="tel"/>
</div>
<span class="text-[11px] text-error hidden mt-1" id="err-seller-phone">Phone number is required.</span>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<div>
<label class="block text-xs font-bold text-on-surface mb-1.5">Password *</label>
<div class="relative">
<input class="w-full px-3.5 py-2.5 pr-10 rounded-lg border border-outline-variant/60 bg-surface-container-low/40 text-sm focus:border-primary focus:bg-white outline-none" id="seller-pass" oninput="validatePasswordRules(this.value, 'seller')" placeholder="••••••••" type="password"/>
<button class="absolute right-3 top-2.5 text-outline hover:text-on-surface" onclick="togglePassVisibility('seller-pass', this)" type="button">
<span class="material-symbols-outlined text-[18px]">visibility</span>
</button>
</div>
</div>
<div>
<label class="block text-xs font-bold text-on-surface mb-1.5">Confirm Password *</label>
<div class="relative">
<input class="w-full px-3.5 py-2.5 pr-10 rounded-lg border border-outline-variant/60 bg-surface-container-low/40 text-sm focus:border-primary focus:bg-white outline-none" id="seller-pass-confirm" placeholder="••••••••" type="password"/>
<button class="absolute right-3 top-2.5 text-outline hover:text-on-surface" onclick="togglePassVisibility('seller-pass-confirm', this)" type="button">
<span class="material-symbols-outlined text-[18px]">visibility</span>
</button>
</div>
<span class="text-[11px] text-error hidden mt-1" id="err-seller-pass-match">Passwords do not match.</span>
</div>
</div>
<!-- Live password criteria & strength indicator -->
<div class="p-3.5 bg-surface-container-low/60 rounded-xl space-y-2 text-xs text-on-surface-variant border border-outline-variant/40">
<div class="flex items-center justify-between mb-1">
<span class="font-bold text-[11px] uppercase tracking-wider text-outline">Password Strength:</span>
<span class="text-[11px] font-bold text-outline" id="seller-strength-text">Not entered</span>
</div>
<!-- Strength Bar -->
<div class="w-full h-1.5 bg-surface-container-high rounded-full overflow-hidden">
<div class="h-full bg-outline/40 transition-all duration-300 w-0" id="seller-strength-bar"></div>
</div>
<div class="pt-1.5 space-y-1.5">
<div class="flex items-center gap-1.5" id="seller-req-len">
<span class="material-symbols-outlined text-[16px] text-outline">radio_button_unchecked</span>
<span>At least 8 characters</span>
</div>
<div class="flex items-center gap-1.5" id="seller-req-up">
<span class="material-symbols-outlined text-[16px] text-outline">radio_button_unchecked</span>
<span>At least one uppercase letter (A-Z)</span>
</div>
<div class="flex items-center gap-1.5" id="seller-req-num">
<span class="material-symbols-outlined text-[16px] text-outline">radio_button_unchecked</span>
<span>At least one numeric digit (0-9)</span>
</div>
</div>
</div>
<div class="pt-2">
<button class="w-full py-3.5 bg-primary hover:bg-primary-hover text-on-primary font-bold rounded-xl shadow-sm transition-all flex items-center justify-center gap-2" onclick="nextSellerStep(1)">
<span>Continue to Business Details</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</button>
</div>
</div>
<!-- Seller Step 2: Business Info -->
<div class="hidden space-y-5" id="seller-step-2">
<div>
<h2 class="text-2xl font-bold text-on-surface">Business Information</h2>
<p class="text-xs text-on-surface-variant mt-1.5">Tell us about your brand and storefront identity.</p>
</div>
<div>
<label class="block text-xs font-bold text-on-surface mb-1.5">Business / Store Name *</label>
<input class="w-full px-3.5 py-2.5 rounded-lg border border-outline-variant/60 bg-surface-container-low/40 text-sm focus:border-primary focus:bg-white outline-none" id="seller-biz-name" oninput="autoSuggestHandle(this.value)" placeholder="Jameson Provisions" type="text"/>
<span class="text-[11px] text-error hidden mt-1" id="err-seller-biz">Store name is required.</span>
</div>
<div>
<div class="flex justify-between items-center mb-1.5">
<label class="text-xs font-bold text-on-surface">Store Username / Handle *</label>
<span class="text-xs font-semibold text-primary hidden" id="handle-feedback">Username available ✓</span>
</div>
<div class="flex items-center">
<span class="px-3 py-2.5 bg-surface-container-high border border-r-0 border-outline-variant/60 rounded-l-lg text-xs font-mono text-outline">sleec.app/</span>
<input class="flex-1 px-3.5 py-2.5 rounded-r-lg border border-outline-variant/60 bg-surface-container-low/40 text-sm font-mono focus:border-primary focus:bg-white outline-none" id="seller-handle" oninput="checkHandleAvailability(this.value)" placeholder="jameson" type="text"/>
</div>
<span class="text-[11px] text-error hidden mt-1" id="err-seller-handle">Handle is already taken or invalid.</span>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<div>
<label class="block text-xs font-bold text-on-surface mb-1.5">Business Category *</label>
<select class="w-full px-3.5 py-2.5 rounded-lg border border-outline-variant/60 bg-surface-container-low/40 text-sm focus:border-primary focus:bg-white outline-none" id="seller-category">
<option value="Home &amp; Kitchen">Home &amp; Kitchen</option>
<option value="Fashion">Fashion &amp; Apparel</option>
<option value="Beauty">Beauty &amp; Cosmetics</option>
<option value="Food &amp; Restaurant">Food &amp; Restaurant</option>
<option value="Electronics">Electronics &amp; Gadgets</option>
<option value="Grocery">Supermarket &amp; Grocery</option>
<option value="Accessories">Accessories &amp; Jewelry</option>
<option value="Health &amp; Wellness">Health &amp; Wellness</option>
<option value="Services">Services</option>
<option value="Other">Other</option>
</select>
</div>
<div>
<label class="block text-xs font-bold text-on-surface mb-1.5">Primary Location *</label>
<input class="w-full px-3.5 py-2.5 rounded-lg border border-outline-variant/60 bg-surface-container-low/40 text-sm focus:border-primary focus:bg-white outline-none" id="seller-location" placeholder="Lagos, Nigeria" type="text"/>
</div>
