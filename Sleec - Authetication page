<script>
    // State Tracker
    let selectedRole = 'seller'; // 'seller' or 'buyer'
    let currentLoginRole = 'seller';
    let sellerStep = 1;
    let buyerStep = 1;
    let countdownIntervals = {};
    let toastTimeout;

    function showToast(message, title = 'Notification') {
      const toast = document.getElementById('toast-message');
      const textEl = document.getElementById('toast-text');
      const titleEl = document.getElementById('toast-title');

      if (message.includes('—')) {
        const parts = message.split('—');
        titleEl.innerText = parts[0].trim();
        textEl.innerText = parts[1].trim();
      } else {
        titleEl.innerText = title;
        textEl.innerText = message;
      }

      clearTimeout(toastTimeout);
      toast.classList.remove('translate-y-20', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      toastTimeout = setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3000);
    }

    function togglePassVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      const icon = btn.querySelector('.material-symbols-outlined');
      if (input.type === 'password') {
        input.type = 'text';
        icon.innerText = 'visibility_off';
      } else {
        input.type = 'password';
        icon.innerText = 'visibility';
      }
    }

    function selectRole(role) {
      selectedRole = role;
      const sellerCard = document.getElementById('role-seller');
      const buyerCard = document.getElementById('role-buyer');

      sellerCard.classList.toggle('active', role === 'seller');
      sellerCard.classList.toggle('border-primary', role === 'seller');
      sellerCard.classList.toggle('bg-[#f4f6f0]', role === 'seller');
      sellerCard.classList.toggle('border-outline-variant/60', role !== 'seller');
      sellerCard.classList.toggle('bg-surface-container-lowest', role !== 'seller');
      
      buyerCard.classList.toggle('active', role === 'buyer');
      buyerCard.classList.toggle('border-primary', role === 'buyer');
      buyerCard.classList.toggle('bg-[#f4f6f0]', role === 'buyer');
      buyerCard.classList.toggle('border-outline-variant/60', role !== 'buyer');
      buyerCard.classList.toggle('bg-surface-container-lowest', role !== 'buyer');
    }

    function goToView(view) {
      ['view-entry', 'view-seller-register', 'view-buyer-register', 'view-login', 'view-forgot-password', 'view-success'].forEach(id => {
        document.getElementById(id).classList.add('hidden');
      });

      const backBtn = document.getElementById('back-nav-btn');

      if (view === 'entry') {
        document.getElementById('view-entry').classList.remove('hidden');
        backBtn.classList.add('hidden');
      } else if (view === 'seller-register') {
        document.getElementById('view-seller-register').classList.remove('hidden');
        backBtn.classList.remove('hidden');
        updateSellerStepView();
      } else if (view === 'buyer-register') {
        document.getElementById('view-buyer-register').classList.remove('hidden');
        backBtn.classList.remove('hidden');
        updateBuyerStepView();
      } else if (view === 'login') {
        document.getElementById('view-login').classList.remove('hidden');
        backBtn.classList.remove('hidden');
      } else if (view === 'forgot') {
        document.getElementById('view-forgot-password').classList.remove('hidden');
        backBtn.classList.remove('hidden');
      } else if (view === 'success') {
        document.getElementById('view-success').classList.remove('hidden');
        backBtn.classList.add('hidden');
      }
    }

    function handleBackNav() {
      if (!document.getElementById('view-seller-register').classList.contains('hidden')) {
        if (sellerStep > 1) {
          prevSellerStep(sellerStep);
        } else {
          goToView('entry');
        }
      } else if (!document.getElementById('view-buyer-register').classList.contains('hidden')) {
        if (buyerStep > 1) {
          prevBuyerStep(buyerStep);
        } else {
          goToView('entry');
        }
      } else if (!document.getElementById('view-forgot-password').classList.contains('hidden')) {
        goToView('login');
      } else {
        goToView('entry');
      }
    }

    function startRegistrationFlow() {
      if (selectedRole === 'seller') {
        sellerStep = 1;
        goToView('seller-register');
      } else {
        buyerStep = 1;
        goToView('buyer-register');
      }
    }

    function startLoginFlow() {
      setLoginRole(selectedRole);
      goToView('login');
    }

    function goToRegistrationFromLogin() {
      goToView(currentLoginRole === 'seller' ? 'seller-register' : 'buyer-register');
    }

    // --- LIVE PASSWORD VALIDATION & STRENGTH INDICATOR ---
    function validatePasswordRules(val, type) {
      const hasLen = val.length >= 8;
      const hasUp = /[A-Z]/.test(val);
      const hasNum = /[0-9]/.test(val);

      function updateReq(elId, pass) {
        const el = document.getElementById(elId);
        if (!el) return;
        const icon = el.querySelector('.material-symbols-outlined');
        if (pass) {
          icon.innerText = 'check_circle';
          icon.className = 'material-symbols-outlined text-[16px] text-primary';
          el.classList.add('text-primary');
          el.classList.remove('text-on-surface-variant');
        } else {
          icon.innerText = 'radio_button_unchecked';
          icon.className = 'material-symbols-outlined text-[16px] text-outline';
          el.classList.remove('text-primary');
          el.classList.add('text-on-surface-variant');
        }
      }

      updateReq(`${type}-req-len`, hasLen);
      updateReq(`${type}-req-up`, hasUp);
      updateReq(`${type}-req-num`, hasNum);

      // Strength evaluation
      let score = 0;
      if (hasLen) score++;
      if (hasUp) score++;
      if (hasNum) score++;
      if (val.length >= 10 && /[^A-Za-z0-9]/.test(val)) score++;

      const strengthBar = document.getElementById(`${type}-strength-bar`);
      const strengthText = document.getElementById(`${type}-strength-text`);

      if (!strengthBar || !strengthText) return;

      if (!val) {
        strengthBar.style.width = '0%';
        strengthBar.className = 'h-full bg-outline/40 transition-all duration-300';
        strengthText.innerText = 'Not entered';
        strengthText.className = 'text-[11px] font-bold text-outline';
      } else if (score <= 1) {
        strengthBar.style.width = '30%';
        strengthBar.className = 'h-full bg-error transition-all duration-300';
        strengthText.innerText = 'Weak';
        strengthText.className = 'text-[11px] font-bold text-error';
      } else if (score === 2) {
        strengthBar.style.width = '65%';
        strengthBar.className = 'h-full bg-amber-500 transition-all duration-300';
        strengthText.innerText = 'Fair';
        strengthText.className = 'text-[11px] font-bold text-amber-600';
      } else {
        strengthBar.style.width = '100%';
        strengthBar.className = 'h-full bg-primary transition-all duration-300';
        strengthText.innerText = 'Strong';
        strengthText.className = 'text-[11px] font-bold text-primary';
      }

      return hasLen && hasUp && hasNum;
    }

    // --- SELLER MULTI-STEP LOGIC ---
    function updateSellerStepView() {
      for (let i = 1; i <= 4; i++) {
        document.getElementById(`seller-step-${i}`).classList.toggle('hidden', i !== sellerStep);
      }
      const labels = [
        "Step 1 of 4: Account Details",
        "Step 2 of 4: Business Information",
        "Step 3 of 4: Store Preferences",
        "Step 4 of 4: Email Verification"
      ];
      const pcts = ["25%", "50%", "75%", "100%"];
      document.getElementById('seller-step-label').innerText = labels[sellerStep - 1];
      document.getElementById('seller-step-pct').innerText = pcts[sellerStep - 1];
      document.getElementById('seller-progress-bar').style.width = pcts[sellerStep - 1];
    }

    function nextSellerStep(current) {
      if (current === 1) {
        const fn = document.getElementById('seller-fn').value.trim();
        const ln = document.getElementById('seller-ln').value.trim();
        const em = document.getElementById('seller-email').value.trim();
        const ph = document.getElementById('seller-phone').value.trim();
        const p1 = document.getElementById('seller-pass').value;
        const p2 = document.getElementById('seller-pass-confirm').value;

        let valid = true;
        document.getElementById('err-seller-fn').classList.toggle('hidden', fn !== '');
        if (!fn) valid = false;
        document.getElementById('err-seller-ln').classList.toggle('hidden', ln !== '');
        if (!ln) valid = false;
        document.getElementById('err-seller-email').classList.toggle('hidden', em.includes('@') && em.includes('.'));
        if (!em.includes('@')) valid = false;
        document.getElementById('err-seller-phone').classList.toggle('hidden', ph !== '');
        if (!ph) valid = false;

        const pValid = validatePasswordRules(p1, 'seller');
        document.getElementById('err-seller-pass-match').classList.toggle('hidden', p1 === p2 && pValid);
        if (p1 !== p2 || !pValid) valid = false;

        if (!valid) {
          showToast('Please fix highlighted fields and meet password requirements', 'Action Required');
          return;
        }

        sellerStep = 2;
        updateSellerStepView();
      } else if (current === 2) {
        const biz = document.getElementById('seller-biz-name').value.trim();
        const hdl = document.getElementById('seller-handle').value.trim();
        if (!biz || !hdl) {
          showToast('Please provide your Store Name and Username', 'Incomplete details');
          return;
        }
        sellerStep = 3;
        updateSellerStepView();
      } else if (current === 3) {
        const emailVal = document.getElementById('seller-email').value.trim() || 'seller@sleecstore.com';
        document.getElementById('otp-target-email').innerText = emailVal;
        sellerStep = 4;
        updateSellerStepView();
        initOtpInputs('seller-otp-container');
        startCountdown('seller');
      }
    }

    function prevSellerStep(current) {
      if (current > 1) {
        sellerStep = current - 1;
        updateSellerStepView();
      }
    }

    function autoSuggestHandle(name) {
      const handleInput = document.getElementById('seller-handle');
      const clean = name.toLowerCase().replace(/[^a-z0-9]/g, '');
      if (clean.length > 2 && !handleInput.dataset.manual) {
        handleInput.value = clean;
        checkHandleAvailability(clean);
      }
    }

    function checkHandleAvailability(hdl) {
      const feedback = document.getElementById('handle-feedback');
      const err = document.getElementById('err-seller-handle');
      if (hdl.toLowerCase() === 'taken' || hdl.toLowerCase() === 'admin') {
        feedback.classList.add('hidden');
        err.classList.remove('hidden');
      } else if (hdl.length >= 3) {
        feedback.classList.remove('hidden');
        err.classList.add('hidden');
      } else {
        feedback.classList.add('hidden');
        err.classList.add('hidden');
      }
    }

    function togglePill(el) {
      el.classList.toggle('selected');
      if (el.classList.contains('selected')) {
        el.classList.add('bg-primary', 'text-white', 'border-primary');
        el.classList.remove('bg-surface-container-lowest', 'text-on-surface-variant');
      } else {
        el.classList.remove('bg-primary', 'text-white', 'border-primary');
        el.classList.add('text-on-surface-variant');
      }
    }

    // --- BUYER MULTI-STEP LOGIC ---
    function updateBuyerStepView() {
      for (let i = 1; i <= 3; i++) {
        document.getElementById(`buyer-step-${i}`).classList.toggle('hidden', i !== buyerStep);
      }
      const labels = [
        "Step 1 of 3: Profile Details",
        "Step 2 of 3: Shopping Preferences",
        "Step 3 of 3: Email Verification"
      ];
      const pcts = ["33%", "66%", "100%"];
      document.getElementById('buyer-step-label').innerText = labels[buyerStep - 1];
      document.getElementById('buyer-step-pct').innerText = pcts[buyerStep - 1];
      document.getElementById('buyer-progress-bar').style.width = pcts[buyerStep - 1];
    }

    function nextBuyerStep(current) {
      if (current === 1) {
        const fn = document.getElementById('buyer-fn').value.trim();
        const ln = document.getElementById('buyer-ln').value.trim();
        const em = document.getElementById('buyer-email').value.trim();
        const p1 = document.getElementById('buyer-pass').value;
        const p2 = document.getElementById('buyer-pass-confirm').value;

        let valid = true;
        document.getElementById('err-buyer-fn').classList.toggle('hidden', fn !== '');
        if (!fn) valid = false;
        document.getElementById('err-buyer-ln').classList.toggle('hidden', ln !== '');
        if (!ln) valid = false;
        document.getElementById('err-buyer-email').classList.toggle('hidden', em.includes('@'));
        if (!em.includes('@')) valid = false;

        const pValid = validatePasswordRules(p1, 'buyer');
        document.getElementById('err-buyer-pass-match').classList.toggle('hidden', p1 === p2 && pValid);
        if (p1 !== p2 || !pValid) valid = false;

        if (!valid) {
          showToast('Please fill in required fields and satisfy password requirements', 'Action Required');
          return;
        }
        buyerStep = 2;
        updateBuyerStepView();
      } else if (current === 2) {
        const emailVal = document.getElementById('buyer-email').value.trim() || 'buyer@example.com';
        document.getElementById('otp-target-email-buyer').innerText = emailVal;
        buyerStep = 3;
        updateBuyerStepView();
        initOtpInputs('buyer-otp-container');
        startCountdown('buyer');
      }
    }

    function prevBuyerStep(current) {
      if (current > 1) {
        buyerStep = current - 1;
        updateBuyerStepView();
      }
    }

    // --- OTP INPUT AUTO-ADVANCE & PASTE LOGIC ---
    function initOtpInputs(containerId) {
      const container = document.getElementById(containerId);
      if (!container) return;
      const inputs = container.querySelectorAll('.otp-input');

      inputs.forEach((input, idx) => {
        input.value = '';
        input.onkeydown = function(e) {
          if (e.key === 'Backspace' && !input.value && idx > 0) {
            inputs[idx - 1].focus();
          }
        };
        input.oninput = function(e) {
          if (input.value.length >= 1 && idx < inputs.length - 1) {
            inputs[idx + 1].focus();
          }
        };
        input.onpaste = function(e) {
          e.preventDefault();
          const pasted = (e.clipboardData || window.clipboardData).getData('text').trim();
          if (/^\d+$/.test(pasted)) {
            for (let i = 0; i < inputs.length; i++) {
              inputs[i].value = pasted[i] || '';
            }
            if (inputs[Math.min(pasted.length, inputs.length) - 1]) {
              inputs[Math.min(pasted.length, inputs.length) - 1].focus();
            }
          }
        };
      });
      if (inputs[0]) setTimeout(() => inputs[0].focus(), 100);
    }

    function startCountdown(type) {
      if (countdownIntervals[type]) {
        clearInterval(countdownIntervals[type]);
      }
      let seconds = 30;
      const countEl = document.getElementById(`resend-countdown-${type}`);
      const btn = document.getElementById(`resend-btn-${type}`);
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = `Resend in <span id="resend-countdown-${type}">00:30</span>`;
      }

      countdownIntervals[type] = setInterval(() => {
        seconds--;
        const currentCountEl = document.getElementById(`resend-countdown-${type}`);
        if (currentCountEl) {
          currentCountEl.innerText = `00:${seconds < 10 ? '0' : ''}${seconds}`;
        }
        if (seconds <= 0) {
          clearInterval(countdownIntervals[type]);
          if (btn) {
            btn.disabled = false;
            btn.innerText = 'Resend Code Now';
          }
        }
      }, 1000);
    }

    function resendOtp(type) {
      // Sleek toast notification requested: 'Verification code sent — A new verification code has been sent to your email'
      showToast('Verification code sent — A new verification code has been sent to your email');
      startCountdown(type);
    }

    function verifyOtpAndComplete(type) {
      const container = document.getElementById(`${type}-otp-container`);
      const inputs = container.querySelectorAll('.otp-input');
      let code = '';
      inputs.forEach(i => code += i.value);

      const err = document.getElementById(`otp-error-${type}`);
      if (code === '123456' || code.length === 6) {
        if (err) err.classList.add('hidden');
        showSuccessState(type);
      } else {
        if (err) err.classList.remove('hidden');
        showToast('Invalid verification code. Please try 123456', 'Verification Failed');
      }
    }

    function showSuccessState(type) {
      goToView('success');
      const title = document.getElementById('success-title');
      const desc = document.getElementById('success-desc');
      const name = document.getElementById('success-user-name');
      const handle = document.getElementById('success-user-handle');
      const btnText = document.getElementById('success-btn-text');
      const avatar = document.getElementById('success-avatar');
      const badge = document.getElementById('success-badge-status');

      if (type === 'seller') {
        const storeName = document.getElementById('seller-biz-name').value || 'Jameson Provisions';
        const storeHandle = document.getElementById('seller-handle').value || 'jameson';
        title.innerText = 'Welcome to Sleec.';
        desc.innerText = "Your seller account is ready. Let's build and manage your storefront.";
        name.innerText = storeName;
        handle.innerText = `@${storeHandle}`;
        avatar.innerText = storeName.charAt(0).toUpperCase();
        badge.innerText = 'Verified Merchant ✓';
        btnText.innerText = 'Continue to Seller Dashboard';
      } else {
        const fn = document.getElementById('buyer-fn').value || 'Amina';
        const ln = document.getElementById('buyer-ln').value || 'Eze';
        title.innerText = 'Welcome to Sleec.';
        desc.innerText = 'Your buyer account is ready. Start discovering verified local businesses and products.';
        name.innerText = `${fn} ${ln}`;
        handle.innerText = 'Verified Shopper';
        avatar.innerText = fn.charAt(0).toUpperCase();
        badge.innerText = 'Registered Shopper ✓';
        btnText.innerText = 'Start Shopping with Sleec';
      }
    }

    function navigateFinalDestination() {
      if (selectedRole === 'seller') {
        showToast('Redirecting to Sleec Seller Dashboard...', 'Accessing Storefront');
        setTimeout(() => {
          alert('Prototype action: Navigating to Sleec Seller Dashboard (#dashboard)');
        }, 800);
      } else {
        showToast('Redirecting to Sleec Marketplace...', 'Accessing Catalog');
        setTimeout(() => {
          alert('Prototype action: Navigating to Sleec Shopping Experience (#storefront)');
        }, 800);
      }
    }

    // --- LOGIN ACTIONS ---
    function setLoginRole(role) {
      currentLoginRole = role;
      const sBtn = document.getElementById('login-role-seller-btn');
      const bBtn = document.getElementById('login-role-buyer-btn');
      const sForm = document.getElementById('seller-login-form');
      const bForm = document.getElementById('buyer-login-form');

      if (role === 'seller') {
        sBtn.className = "flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-lg bg-white shadow-sm text-primary transition-all";
        bBtn.className = "flex-1 py-2.5 text-xs sm:text-sm font-semibold rounded-lg text-on-surface-variant hover:text-on-surface transition-all";
        sForm.classList.remove('hidden');
        bForm.classList.add('hidden');
      } else {
        bBtn.className = "flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-lg bg-white shadow-sm text-primary transition-all";
        sBtn.className = "flex-1 py-2.5 text-xs sm:text-sm font-semibold rounded-lg text-on-surface-variant hover:text-on-surface transition-all";
        bForm.classList.remove('hidden');
        sForm.classList.add('hidden');
      }
    }

    function submitSellerLogin() {
      const email = document.getElementById('login-seller-email').value;
      const pass = document.getElementById('login-seller-pass').value;
      if (email && pass) {
        showToast('Signing into merchant account...', 'Authenticated');
        setTimeout(() => {
          completeLoginSuccess('seller');
        }, 800);
      }
    }

    function submitBuyerLogin() {
      const email = document.getElementById('login-buyer-email').value;
      const pass = document.getElementById('login-buyer-pass').value;
      if (email && pass) {
        showToast('Signing in to your buyer profile...', 'Authenticated');
        setTimeout(() => {
          completeLoginSuccess('buyer');
        }, 800);
      }
    }

    function loginBuyerViaOtpInstant() {
      const email = document.getElementById('login-buyer-email').value;
      if (email && email.includes('@')) {
        showToast('Verification code sent — A new verification code has been sent to your email');
        document.getElementById('otp-target-email-buyer').innerText = email;
        goToView('buyer-register');
        buyerStep = 3;
        updateBuyerStepView();
        initOtpInputs('buyer-otp-container');
        startCountdown('buyer');
      } else {
        showToast('Please enter a valid email address first');
      }
    }

    function completeLoginSuccess(role) {
      selectedRole = role;
      showToast('Login successful! Welcome back.');
      setTimeout(() => {
        if (role === 'seller') {
          alert('Welcome back, Jameson Okoro! Entering Sleec Seller Dashboard.');
        } else {
          alert('Welcome back, Amina Eze! Entering Sleec Buyer Marketplace.');
        }
      }, 700);
    }

    // --- FORGOT PASSWORD ACTIONS ---
    function goToForgotPassword(role = 'seller') {
      const emailVal = role === 'seller' 
        ? document.getElementById('login-seller-email').value 
        : document.getElementById('login-buyer-email').value;
      
      document.getElementById('reset-email').value = emailVal || '';
      goToView('forgot');
      document.getElementById('forgot-step-1').classList.remove('hidden');
      document.getElementById('forgot-step-2').classList.add('hidden');
      document.getElementById('forgot-step-3').classList.add('hidden');
    }

    function sendResetCode() {
      const email = document.getElementById('reset-email').value;
      if (email && email.includes('@')) {
        showToast('Verification code sent — A new verification code has been sent to your email');
        document.getElementById('reset-target-email-display').innerText = email;
        document.getElementById('forgot-step-1').classList.add('hidden');
        document.getElementById('forgot-step-2').classList.remove('hidden');
        initOtpInputs('reset-otp-container');
        startCountdown('reset');
      } else {
        showToast('Please enter a valid account email', 'Error');
      }
    }

    function verifyResetCode() {
      const container = document.getElementById('reset-otp-container');
      const inputs = container.querySelectorAll('.otp-input');
      let code = '';
      inputs.forEach(i => code += i.value);

      if (code === '123456' || code.length === 6) {
        document.getElementById('forgot-step-2').classList.add('hidden');
        document.getElementById('forgot-step-3').classList.remove('hidden');
      } else {
        document.getElementById('otp-error-reset').classList.remove('hidden');
        showToast('Invalid verification code. Please enter 123456', 'Verification Failed');
      }
    }

    function saveNewPassword() {
      const p1 = document.getElementById('reset-new-pass').value;
      const p2 = document.getElementById('reset-confirm-pass').value;
      const err = document.getElementById('err-reset-match');

      const pValid = validatePasswordRules(p1, 'reset');

      if (!pValid) {
        showToast('New password must satisfy all 3 criteria above', 'Requirements Not Met');
        return;
      }

      if (p1 !== p2) {
        err.classList.remove('hidden');
        showToast('Password confirmation does not match', 'Error');
        return;
      }
      err.classList.add('hidden');

      showToast('Password updated! You can now log in with your new credentials.', 'Success');
      setTimeout(() => {
        goToView('login');
      }, 1200);
    }
  </script>
