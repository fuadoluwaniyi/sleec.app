        document.getElementById('promo-next').disabled = true;
        document.getElementById('promo-prev').disabled = true;
        content.innerHTML=`<div class='flex flex-col items-center justify-center h-full text-center py-xl'><span class='material-symbols-outlined text-[48px] text-primary animate-spin mb-md'>sync</span><p class='font-label-md'>Submitting request...</p></div>`;
        setTimeout(() => {
            promoStep++;
            document.getElementById('promo-next').disabled = false;
            document.getElementById('promo-prev').disabled = false;
            renderPromoStep();
        }, 1500);
    } else if(promoStep<5){
        promoStep++;
        renderPromoStep();
    }else{
        closePromotionWizard();
    }
}

function promoPrev(){
    if(promoStep>1 && promoStep<5){
