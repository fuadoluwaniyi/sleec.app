function updateWizard(){const step=steps[wizardState.step-1];document.getElementById('wizard-step-num').innerText=wizardState.step;document.getElementById('wizard-step-title').innerText=step.title;document.getElementById('wizard-content-area').innerHTML=step.render();document.getElementById('wizard-prev').style.visibility=wizardState.step===1?'hidden':'visible';document.getElementById('wizard-next').innerText=wizardState.step===7?'Launch Campaign':'Continue';const stepper=document.getElementById('stepper-container');stepper.innerHTML=steps.map((s,i)=>`<div class='flex items-center gap-sm ${i+1===wizardState.step?'text-primary font-bold':(i+1<wizardState.step?'text-primary/60':'text-outline')}'><div class='w-6 h-6 rounded-full flex items-center justify-center border ${i+1===wizardState.step?'bg-primary text-white border-primary':'border-outline'}'>${i+1<wizardState.step?'✓':i+1}</div><span class='text-label-md'>${s.title}</span></div>`).join('');}
document.getElementById('wizard-next').onclick=()=>{if(wizardState.step<7){wizardState.step++;updateWizard();}else{launchCampaign();}};
document.getElementById('wizard-prev').onclick=()=>{if(wizardState.step>1){wizardState.step--;updateWizard();}};
document.getElementById('wizard-draft').onclick=()=>{saveDraft();};

function saveDraft(){closeWizard();const table=document.getElementById('campaignList');const row=document.createElement('tr');const newId = 'camp' + Date.now();row.id=newId;row.className='group hover:bg-surface-container/50 transition-colors border-b border-outline-variant/10 cursor-pointer';row.onclick=()=>manageCampaign(newId, wizardState.data.name||'Untitled Draft', 'Draft');row.innerHTML=`<td class='p-sm'><p class='font-label-sm'>${wizardState.data.name||'Untitled Draft'}</p><p class='text-[10px] opacity-70'>Draft</p></td><td class='p-sm'>-</td><td class='p-sm'>-</td><td class='p-sm'>-</td><td class='p-sm'>-</td><td class='p-sm text-right'><span class='inline-flex items-center px-sm py-[2px] rounded-full bg-surface-container-high text-on-surface text-[10px] font-semibold status-badge'>Draft</span></td>`;table.insertBefore(row,table.firstChild);if(table.children.length>3)table.lastChild.remove();showToast('Draft Saved','You can resume this campaign later.');}
function showToast(title,msg){const t=document.getElementById('toast');t.querySelector('.font-label-md').innerText=title;t.querySelector('.font-body-sm').innerText=msg;t.classList.remove('translate-y-20','opacity-0');setTimeout(()=>t.classList.add('translate-y-20','opacity-0'),3000);}
window.openWizard=()=>{document.getElementById('campaignWizard').style.display='flex';wizardState.step=1;updateWizard();};

let currentCampaignId = '';
function manageCampaign(id, name, status) {
    currentCampaignId = id;
    document.getElementById('mgmtCampaignName').innerText = name;
    
    const actionsContainer = document.getElementById('mgmtActions');
    actionsContainer.innerHTML = '';
    
    let btn1 = document.createElement('button');
    btn1.className = 'w-full py-sm rounded-lg bg-[#728156] text-white font-label-md shadow-sm hover:bg-surface-tint transition-colors mb-sm';
    
    let btn2 = document.createElement('button');
    btn2.className = 'w-full py-sm rounded-lg border border-error text-error font-label-md hover:bg-error-container transition-colors';
    btn2.innerText = 'Delete Campaign';
    btn2.onclick = () => { deleteCampaign(); document.getElementById('campaignManagementModal').classList.add('hidden'); };

    if (status === 'Active') {
        let viewBtn = document.createElement('button');
        viewBtn.className = 'w-full py-sm rounded-lg border border-outline-variant text-on-surface font-label-md hover:bg-surface-container transition-colors mb-sm';
        viewBtn.innerText = 'View Details';
        actionsContainer.appendChild(viewBtn);

        btn1.innerText = 'Deactivate';
        btn1.onclick = () => { changeStatus('Stopped'); document.getElementById('campaignManagementModal').classList.add('hidden'); };
    } else if (status === 'Draft') {
        let editBtn = document.createElement('button');
        editBtn.className = 'w-full py-sm rounded-lg border border-outline-variant text-on-surface font-label-md hover:bg-surface-container transition-colors mb-sm';
        editBtn.innerText = 'Continue Editing';
        actionsContainer.appendChild(editBtn);

        btn1.innerText = 'Make Campaign Live';
        btn1.onclick = () => { changeStatus('Active'); document.getElementById('campaignManagementModal').classList.add('hidden'); };
    } else if (status === 'Stopped') {
        let viewBtn = document.createElement('button');
        viewBtn.className = 'w-full py-sm rounded-lg border border-outline-variant text-on-surface font-label-md hover:bg-surface-container transition-colors mb-sm';
        viewBtn.innerText = 'View Details';
        actionsContainer.appendChild(viewBtn);

        btn1.innerText = 'Reactivate';
        btn1.onclick = () => { changeStatus('Active'); document.getElementById('campaignManagementModal').classList.add('hidden'); };
    }
    
    actionsContainer.appendChild(btn1);
    actionsContainer.appendChild(btn2);
    
    document.getElementById('campaignManagementModal').classList.remove('hidden');
}

function changeStatus(newStatus) {
    const row = document.getElementById(currentCampaignId);
    if (!row) return;
    const badge = row.querySelector('.status-badge');
    badge.innerText = newStatus;
    
    if (newStatus === 'Active') {
        badge.className = 'inline-flex items-center px-sm py-[2px] rounded-full bg-[#d9e9b9] text-[#3e4b28] text-[10px] font-semibold status-badge';
    } else if (newStatus === 'Stopped') {
        badge.className = 'inline-flex items-center px-sm py-[2px] rounded-full bg-error-container text-on-error-container text-[10px] font-semibold status-badge';
    }
    
    // Update onclick handler
    const name = document.getElementById('mgmtCampaignName').innerText;
    row.onclick = () => manageCampaign(currentCampaignId, name, newStatus);
    
    updateActiveCount();
}

function deleteCampaign() {
    const row = document.getElementById(currentCampaignId);
    if (row) {
        row.remove();
        updateActiveCount();
        showToast('Campaign Deleted', 'The campaign has been removed.');
    }
}

function updateActiveCount() {
    const activeBadges = Array.from(document.querySelectorAll('#campaignList .status-badge')).filter(b => b.innerText === 'Active');
    document.getElementById('activeCampaignsCount').innerText = activeBadges.length;
}

function openAllCampaignsModal() {
    document.getElementById('allCampaignsModal').classList.remove('hidden');
}
</script>
