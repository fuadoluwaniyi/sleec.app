      </div>
      <input type="hidden" id="qdValue" value="SHIPPING">
    </div><div class="space-y-sm"><p class="text-label-sm text-outline uppercase">Coupon Code</p><div class="flex flex-col gap-sm"><label class="flex items-center gap-sm cursor-pointer"><input checked="" class="accent-[#728156]" name="codeType" onchange="toggleCodeInput(false)" type="radio" value="generate"><span class="text-body-sm">Generate Code (e.g., SUMMER20)</span></label><label class="flex items-center gap-sm cursor-pointer"><input class="accent-[#728156]" name="codeType" onchange="toggleCodeInput(true)" type="radio" value="manual"><span class="text-body-sm">Create My Own Code</span></label><input class="w-full p-sm bg-surface border border-outline-variant rounded font-bold tracking-widest uppercase" id="qdManualCode" placeholder="free Dilivery" type="text"></div></div></div><div class="px-lg py-md bg-surface border-t border-outline-variant/30"><button class="w-full py-sm rounded-lg bg-[#728156] text-white font-label-md shadow-sm hover:bg-surface-tint transition-colors" onclick="createQuickCoupon()">Create Coupon</button></div></div></div>
<!-- Delete Confirmation Modal -->
<div class="fixed inset-0 z-[110] bg-on-surface/40 backdrop-blur-sm flex items-center justify-center p-md hidden" id="deleteCouponModal">
<div class="bg-surface-container-lowest w-full max-w-sm rounded-xl shadow-xl p-lg text-center">
<div class="w-16 h-16 bg-error/10 text-error rounded-full flex items-center justify-center mx-auto mb-md">
<span class="material-symbols-outlined text-[32px]">delete_forever</span>
</div>
<h3 class="font-headline-sm text-on-surface mb-xs">Delete this coupon?</h3>
<p class="text-body-sm text-on-surface-variant mb-lg">This action cannot be undone and the code will stop working immediately.</p>
<div class="flex gap-sm">
<button class="flex-1 py-sm rounded-lg border border-outline-variant text-on-surface font-label-md hover:bg-surface-container transition-colors" onclick="closeDeleteModal()">Cancel</button>
<button class="flex-1 py-sm rounded-lg bg-error text-white font-label-md shadow-sm hover:opacity-90 transition-colors" id="confirmDeleteBtn">Delete</button>
</div>
</div>
</div>
<script>
let currentQDType = '';
let couponToDelete = null;

function openQuickDiscount(type) {
  const list = document.getElementById('active-coupons-list');
  if (list.children.length >= 2) {
    showToast('Maximum Active Coupons Reached', 'Please delete an existing coupon before creating a new one.');
    return;
  }
  
  currentQDType = type;
  const modal = document.getElementById('quickDiscountModal');
  const title = document.getElementById('qdModalTitle');
  const valueSection = document.getElementById('qdValueSection');
  
  modal.classList.remove('hidden');
  
  if (type === 'percentage') {
    title.innerText = 'Percentage Discount';
    valueSection.innerHTML = `
      <label class="text-label-sm block mb-xs">Select Percentage</label>
      <select id="qdValue" class="w-full p-sm bg-surface border border-outline-variant rounded text-body-sm">
        <option value="5%">5%</option>
        <option value="10%">10%</option>
        <option value="15%">15%</option>
        <option value="20%" selected>20%</option>
        <option value="25%">25%</option>
        <option value="30%">30%</option>
        <option value="40%">40%</option>
        <option value="50%">50%</option>
        <option value="custom">Custom %</option>
      </select>
      <input type="number" id="qdCustomVal" class="hidden mt-sm w-full p-sm bg-surface border border-outline-variant rounded text-body-sm" placeholder="Enter custom %">
    `;
    document.getElementById('qdValue').onchange = (e) => {
      document.getElementById('qdCustomVal').classList.toggle('hidden', e.target.value !== 'custom');
    };
  } else if (type === 'fixed') {
    title.innerText = 'Fixed Amount Discount';
    valueSection.innerHTML = `
      <label class="text-label-sm block mb-xs">Enter Amount (₦)</label>
      <input type="number" id="qdValue" class="w-full p-sm bg-surface border border-outline-variant rounded text-body-sm" placeholder="e.g. 5000">
    `;
  } else if (type === 'shipping') {
    title.innerText = 'Free Shipping';
    valueSection.innerHTML = `
      <div class="p-sm bg-surface-container rounded border border-outline-variant/30">
        <p class="text-body-sm text-on-surface-variant">This coupon will remove all shipping costs from the customer's order at checkout.</p>
      </div>
      <input type="hidden" id="qdValue" value="SHIPPING">
    `;
  }
}

function toggleCodeInput(show) {
  document.getElementById('qdManualCode').classList.toggle('hidden', !show);
}

function closeQuickDiscount() {
  document.getElementById('quickDiscountModal').classList.add('hidden');
}

function createQuickCoupon() {
  const list = document.getElementById('active-coupons-list');
  const codeType = document.querySelector('input[name="codeType"]:checked').value;
  let code = '';
  
  if (codeType === 'generate') {
    const prefixes = ['SUMMER', 'FLASH', 'SLEEC', 'SAVE'];
    code = prefixes[Math.floor(Math.random() * prefixes.length)] + Math.floor(10 + Math.random() * 89);
  } else {
    code = document.getElementById('qdManualCode').value.toUpperCase() || 'DISCOUNT';
  }
  
  let valDisplay = '';
  const valInput = document.getElementById('qdValue');
  if (currentQDType === 'percentage') {
    valDisplay = valInput.value === 'custom' ? document.getElementById('qdCustomVal').value + '% OFF' : valInput.value + ' OFF';
  } else if (currentQDType === 'fixed') {
    valDisplay = '₦' + valInput.value;
  } else {
    valDisplay = 'SHIPPING';
  }
  
  const div = document.createElement('div');
  div.className = 'flex justify-between items-center p-xs bg-surface-container/30 border border-outline-variant/10 rounded group relative overflow-hidden';
  div.innerHTML = `
    <div class="flex items-center gap-xs text-on-surface">
      <span class="material-symbols-outlined text-[14px]">local_offer</span>
      <span class="text-label-sm font-semibold tracking-wide">${code}</span>
    </div>
    <div class="relative h-6 w-20 flex items-center justify-end">
      <span class="text-[10px] font-semibold text-on-surface bg-surface px-xs py-[2px] border border-outline-variant/20 rounded group-hover:opacity-0 transition-opacity">${valDisplay}</span>
      <button onclick="confirmDeleteCoupon(this)" class="absolute inset-0 flex items-center justify-center bg-error text-white text-[10px] font-bold rounded opacity-0 group-hover:opacity-100 transition-opacity">DELETE</button>
    </div>
  `;
  
  list.appendChild(div);
  closeQuickDiscount();
  showToast('Coupon Created', 'New discount code is now active.');
}

function confirmDeleteCoupon(btn) {
  couponToDelete = btn.closest('.group');
  document.getElementById('deleteCouponModal').classList.remove('hidden');
  document.getElementById('confirmDeleteBtn').onclick = () => {
    couponToDelete.remove();
    closeDeleteModal();
    showToast('Coupon Deleted', 'The discount has been removed.');
  };
}

function closeDeleteModal() {
  document.getElementById('deleteCouponModal').classList.add('hidden');
  couponToDelete = null;
}
</script>

</body></html>
