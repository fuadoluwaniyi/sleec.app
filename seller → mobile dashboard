<script>
  // Interaction Logic
  function openNavDrawer() {
    const backdrop = document.getElementById('nav-drawer-backdrop');
    const drawer = document.getElementById('nav-drawer');
    backdrop.classList.add('active');
    setTimeout(() => drawer.classList.add('active'), 10);
    document.body.classList.add('drawer-open');
  }

  function closeNavDrawer() {
    const backdrop = document.getElementById('nav-drawer-backdrop');
    const drawer = document.getElementById('nav-drawer');
    drawer.classList.remove('active');
    setTimeout(() => {
      backdrop.classList.remove('active');
      document.body.classList.remove('drawer-open');
    }, 300);
  }

  function openDrawer(drawerId) {
    const backdrop = document.getElementById(drawerId + '-backdrop');
    const drawer = document.getElementById(drawerId);
    if(backdrop && drawer) {
      backdrop.classList.add('active');
      setTimeout(() => drawer.classList.add('active'), 10);
      document.body.classList.add('drawer-open');
    }
  }

  function closeDrawer(drawerId) {
    const backdrop = document.getElementById(drawerId + '-backdrop');
    const drawer = document.getElementById(drawerId);
    if(backdrop && drawer) {
      drawer.classList.remove('active');
      setTimeout(() => {
        backdrop.classList.remove('active');
        document.body.classList.remove('drawer-open');
      }, 300);
    }
  }

  function openModal(modalId, backdropId = modalId) {
    const modal = document.getElementById(backdropId) || document.getElementById(modalId);
    const content = document.getElementById(modalId);
    if(modal) {
      modal.classList.add('active');
      if(content && content !== modal) {
         setTimeout(() => content.classList.add('active'), 10);
      }
      document.body.classList.add('drawer-open');
    }
  }

  function closeModal(modalId, backdropId = modalId) {
    const modal = document.getElementById(backdropId) || document.getElementById(modalId);
    const content = document.getElementById(modalId);
    if(modal) {
       if(content && content !== modal) {
           content.classList.remove('active');
       }
      setTimeout(() => {
        modal.classList.remove('active');
        document.body.classList.remove('drawer-open');
      }, 200);
    }
  }

  function showMetricDetail(title, value, description) {
    const titleEl = document.getElementById('generic-modal-title');
    const contentEl = document.getElementById('generic-modal-content');
    
    titleEl.textContent = title;
    contentEl.innerHTML = `
      <div class="flex flex-col items-center justify-center py-xl text-center gap-sm">
        ${value ? `<p class="font-headline-xl text-primary">${value}</p>` : ''}
        <p class="font-body-md text-on-surface-variant">${description}</p>
        <button class="mt-md px-lg py-sm bg-primary text-on-primary rounded-lg font-label-md" onclick="closeModal('generic-modal-wrapper')">Got it</button>
      </div>
    `;
    
    openModal('generic-modal-wrapper', 'generic-modal-backdrop');
  }

  function toggleChartType(btn, type) {
    const parent = document.getElementById('sales-orders-toggle');
    const buttons = parent.querySelectorAll('button');
    
    buttons.forEach(b => {
      b.className = 'px-3 py-1 font-label-sm text-on-surface-variant hover:text-on-surface transition-colors';
    });
    
    btn.className = 'px-3 py-1 bg-surface rounded-md font-label-sm text-primary shadow-sm';
    
    const chartTotal = document.getElementById('chart-total');
    if(type === 'Sales') {
      chartTotal.textContent = '₦1.8M';
    } else {
      chartTotal.textContent = '342';
    }
  }
</script>
