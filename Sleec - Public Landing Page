    function selectHotspot(num) {
      const data = hotspotData[num];
      document.getElementById('hotspot-num').innerText = num;
      document.getElementById('hotspot-title').innerText = data.title;
      document.getElementById('hotspot-desc').innerText = data.desc;

      // Reset card highlights
      for (let i = 1; i <= 4; i++) {
        const card = document.getElementById(`card-hotspot-${i}`);
        if (card) {
          if (i === num) {
            card.classList.add('ring-2', 'ring-brand', 'bg-brand-subtle/30');
          } else {
            card.classList.remove('ring-2', 'ring-brand', 'bg-brand-subtle/30');
          }
        }
      }
    }

