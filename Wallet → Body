                    iconColor: 'bg-tertiary-container/20 text-tertiary',
                    fee: null
                });
                renderTransactions();
            }
        }, 1500);
    }

    function finalizeFunding() {
        const amount = state.fundFlow.amount;
        const provider = state.fundFlow.provider || 'Funding';
        
        state.balances.main += amount;
        state.balances.withdraw += amount;
        updateDOMBalances();
        
        const now = new Date();
        const dateStr = now.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true });
        
        state.transactions.unshift({
            id: 'FND-' + Math.floor(Math.random() * 10000),
            title: `Wallet Funding via ${provider}`,
            type: 'Wallet Fund',
            date: dateStr,
            amount: amount,
            isCredit: true,
            status: 'success',
            icon: 'payments',
            iconColor: 'bg-tertiary-container/20 text-tertiary',
            fee: null
        });
        
        renderTransactions();
        document.getElementById('modal-fund').classList.add('hidden');
    }

    // Withdraw Flow
    function startWithdrawFlow() {
        document.getElementById('withdraw-amount-input').value = '';
        validateWithdrawAmount();
        document.getElementById('modal-withdraw').classList.remove('hidden');
        document.getElementById('withdraw-step-1').classList.remove('hidden');
        document.getElementById('withdraw-step-2').classList.add('hidden');
        document.getElementById('withdraw-processing').classList.add('hidden');
        document.getElementById('withdraw-success').classList.add('hidden');
        document.getElementById('withdraw-failed').classList.add('hidden');
    }

    function validateWithdrawAmount() {
        const input = document.getElementById('withdraw-amount-input');
        const btn = document.getElementById('withdraw-continue-btn');
        const msg = document.getElementById('withdraw-error-msg');
        const val = parseFloat(input.value);
        
        if (isNaN(val) || val <= 0) {
            btn.disabled = true;
            btn.classList.add('opacity-50');
            msg.classList.add('hidden');
        } else if (val > state.balances.withdraw) {
            btn.disabled = true;
            btn.classList.add('opacity-50');
            msg.innerText = "Amount exceeds available balance";
            msg.classList.remove('hidden');
        } else {
            btn.disabled = false;
            btn.classList.remove('opacity-50');
            msg.classList.add('hidden');
        }
    }

    function goToWithdrawStep2() {
        const val = parseFloat(document.getElementById('withdraw-amount-input').value);
        document.getElementById('withdraw-confirm-amount').innerText = formatMoney(val);
        document.getElementById('withdraw-total-deduction').innerText = formatMoney(val + 50);
        
        document.getElementById('withdraw-step-1').classList.add('hidden');
        document.getElementById('withdraw-step-2').classList.remove('hidden');
    }

    function processWithdrawal() {
        document.getElementById('withdraw-step-2').classList.add('hidden');
        document.getElementById('withdraw-processing').classList.remove('hidden');
        
        const amount = parseFloat(document.getElementById('withdraw-amount-input').value);
        
        setTimeout(() => {
            document.getElementById('withdraw-processing').classList.add('hidden');
            
            const isSuccess = state.withdrawFlow.attempts % 2 === 0;
            state.withdrawFlow.attempts++;
            
            const now = new Date();
            const dateStr = now.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true });
            const bankName = document.getElementById('withdrawal-bank-name').innerText;
            
            if (isSuccess) {
                state.balances.main -= (amount + 50);
                state.balances.withdraw -= (amount + 50);
                updateDOMBalances();
                
                state.transactions.unshift({
                    id: 'WD-' + Math.floor(Math.random() * 10000),
                    title: `Withdrawal to ${bankName}`,
                    type: 'Payout',
                    date: dateStr,
                    amount: amount,
                    isCredit: false,
                    status: 'success',
                    icon: 'account_balance',
                    iconColor: 'bg-surface-container-high text-on-surface',
                    fee: 50.00
                });
                
                document.getElementById('withdraw-success').classList.remove('hidden');
            } else {
                state.transactions.unshift({
                    id: 'WD-' + Math.floor(Math.random() * 10000),
                    title: `Withdrawal to ${bankName}`,
                    type: 'Payout',
                    date: dateStr,
                    amount: amount,
                    isCredit: false,
                    status: 'failed',
                    icon: 'account_balance',
                    iconColor: 'bg-surface-container-high text-on-surface',
                    fee: null
                });
                document.getElementById('withdraw-failed').classList.remove('hidden');
            }
            renderTransactions();
        }, 1500);
    }

    // Transfer Flow
    function startTransferFlow() {
        document.getElementById('transfer-username-input').value = '';
        document.getElementById('transfer-amount-input').value = '';
        document.getElementById('transfer-note-input').value = '';
        document.getElementById('transfer-recipient-info').classList.add('hidden');
        validateTransferAmount();
        
        document.getElementById('modal-transfer').classList.remove('hidden');
        document.getElementById('transfer-step-1').classList.remove('hidden');
        document.getElementById('transfer-step-2').classList.add('hidden');
        document.getElementById('transfer-processing').classList.add('hidden');
        document.getElementById('transfer-success').classList.add('hidden');
        document.getElementById('transfer-failed').classList.add('hidden');
    }

    function validateTransferRecipient() {
        const input = document.getElementById('transfer-username-input').value;
        const info = document.getElementById('transfer-recipient-info');
        if (input.toLowerCase() === '@jamesokoro' || input.length > 5) {
             info.classList.remove('hidden');
        } else {
             info.classList.add('hidden');
        }
        validateTransferAmount();
    }

    function validateTransferAmount() {
        const input = document.getElementById('transfer-amount-input');
        const btn = document.getElementById('transfer-continue-btn');
        const msg = document.getElementById('transfer-error-msg');
        const infoVisible = !document.getElementById('transfer-recipient-info').classList.contains('hidden');
        const val = parseFloat(input.value);
        
        if (!infoVisible || isNaN(val) || val <= 0) {
            btn.disabled = true;
            btn.classList.add('opacity-50');
            msg.classList.add('hidden');
        } else if ((val + 10) > state.balances.main) {
            btn.disabled = true;
            btn.classList.add('opacity-50');
            msg.innerText = "Total exceeds available balance";
            msg.classList.remove('hidden');
        } else {
            btn.disabled = false;
            btn.classList.remove('opacity-50');
            msg.classList.add('hidden');
        }
    }

    function goToTransferStep2() {
        const val = parseFloat(document.getElementById('transfer-amount-input').value);
        document.getElementById('transfer-confirm-amount').innerText = formatMoney(val);
        document.getElementById('transfer-total-deduction').innerText = formatMoney(val + 10);
        
        document.getElementById('transfer-step-1').classList.add('hidden');
        document.getElementById('transfer-step-2').classList.remove('hidden');
    }

    function processTransfer() {
        document.getElementById('transfer-step-2').classList.add('hidden');
        document.getElementById('transfer-processing').classList.remove('hidden');
        
        const amount = parseFloat(document.getElementById('transfer-amount-input').value);
        
        setTimeout(() => {
            document.getElementById('transfer-processing').classList.add('hidden');
            
            const isSuccess = state.transferFlow.attempts % 2 === 0;
            state.transferFlow.attempts++;
            
            const now = new Date();
            const dateStr = now.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true });
            
            if (isSuccess) {
                state.balances.main -= (amount + 10);
                state.balances.withdraw -= (amount + 10);
                updateDOMBalances();
                
                state.transactions.unshift({
                    id: 'TRF-' + Math.floor(Math.random() * 10000),
                    title: 'Transfer to James Okoro',
                    type: 'Send Money',
                    date: dateStr,
                    amount: amount,
                    isCredit: false,
                    status: 'success',
                    icon: 'send',
                    iconColor: 'bg-primary/20 text-primary',
                    fee: 10.00
                });
                
                document.getElementById('transfer-success').classList.remove('hidden');
            } else {
                state.transactions.unshift({
                    id: 'TRF-' + Math.floor(Math.random() * 10000),
                    title: 'Transfer to James Okoro',
                    type: 'Send Money',
                    date: dateStr,
                    amount: amount,
                    isCredit: false,
                    status: 'failed',
                    icon: 'send',
                    iconColor: 'bg-primary/20 text-primary',
                    fee: null
                });
                document.getElementById('transfer-failed').classList.remove('hidden');
            }
            renderTransactions();
        }, 1500);
    }

    // Account Verification Flow
    function handleAccountVerification() {
        document.getElementById('update-account-verification').classList.add('hidden');
        document.getElementById('update-account-verifying-state').classList.remove('hidden');
        
        setTimeout(() => {
            document.getElementById('update-account-verifying-state').classList.add('hidden');
            const isSuccess = state.verifyAccountFlow.attempts % 2 === 0;
            state.verifyAccountFlow.attempts++;
            
            if (isSuccess) {
                const bankName = document.getElementById('new-bank-select').value;
                const accNum = document.getElementById('new-account-number').value;
                document.getElementById('verified-account-details').innerText = `${bankName} •••• ${accNum.slice(-4)}`;
                document.getElementById('update-account-verified-success').classList.remove('hidden');
            } else {
                document.getElementById('update-account-verified-failed').classList.remove('hidden');
            }
        }, 2000);
    }
    
    // Payout Schedules
    function renderSchedules() {
        ['daily', 'weekly', 'monthly'].forEach(type => {
            const container = document.getElementById(`payout-${type}`);
            if (state.schedules[type]) {
                const sched = state.schedules[type];
                container.innerHTML = `
                    <div class="bg-surface p-md rounded-xl border border-outline-variant/20 space-y-xs relative group">
                        <div class="flex flex-col gap-xs">
                            <p class="text-label-sm text-on-surface-variant uppercase tracking-wider">Next Payout</p>
                            <p class="text-body-sm font-medium text-primary">${sched.dateStr}</p>
                            <p class="text-body-sm font-semibold text-on-surface">${formatMoney(sched.amount)}</p>
                        </div>
                        <button class="absolute top-2 right-2 p-xs text-on-surface-variant/40 hover:text-error transition-colors" onclick="confirmDeleteSchedule('${type}')" title="Delete Schedule">
                            <span class="material-symbols-outlined text-[18px]">delete</span>
                        </button>
                    </div>
                `;
            } else {
                container.innerHTML = `
                    <div class="bg-surface p-lg rounded-xl border border-outline-variant/20 text-center py-xl min-h-[120px] flex items-center justify-center">
                        <p class="text-body-md font-semibold text-on-surface">No ${type} payout scheduled</p>
                    </div>
                `;
            }
        });
    }

    function switchPayoutTab(type, btn) {
        state.activeTab = type;
        document.querySelectorAll('.payout-tab-content').forEach(el => el.classList.add('hidden'));
        document.getElementById(`payout-${type}`).classList.remove('hidden');
        
        btn.parentElement.querySelectorAll('button').forEach(b => {
            b.classList.remove('bg-surface', 'shadow-sm', 'text-on-surface');
            b.classList.add('text-on-surface-variant');
        });
        btn.classList.add('bg-surface', 'shadow-sm', 'text-on-surface');
        btn.classList.remove('text-on-surface-variant');
    }

    function openScheduleModal() {
        document.getElementById('modal-schedule-payout-flow').classList.remove('hidden');
        document.getElementById('schedule-step-form').classList.remove('hidden');
        document.getElementById('schedule-step-processing').classList.add('hidden');
        document.getElementById('schedule-step-success').classList.add('hidden');
        document.getElementById('modal-replace-schedule').classList.add('hidden');
    }

    function initiateSaveSchedule() {
        const type = document.getElementById('payout-frequency-selector').value;
        if (state.schedules[type]) {
            state.pendingScheduleType = type;
            document.getElementById('replace-schedule-type-text').innerText = type;
            document.getElementById('modal-replace-schedule').classList.remove('hidden');
        } else {
            processSaveSchedule(type);
        }
    }

    function processSaveSchedule(type) {
        document.getElementById('modal-replace-schedule').classList.add('hidden');
        document.getElementById('schedule-step-form').classList.add('hidden');
        document.getElementById('schedule-step-processing').classList.remove('hidden');
        
        const amount = parseFloat(document.getElementById('payout-amount-input').value) || 50000;
        
        setTimeout(() => {
            document.getElementById('schedule-step-processing').classList.add('hidden');
            
            // Dummy date string generation for demo
            let dateStr = 'Today • 10:00 AM';
            if(type === 'weekly') dateStr = 'Wed, Aug 19 • 10:00 AM';
            if(type === 'monthly') dateStr = '1st of Month • 10:00 AM';

            state.schedules[type] = {
                amount: amount,
                dateStr: dateStr
            };
            
            renderSchedules();
            // Optional: automatically switch tab to the newly created schedule type
            // const tabBtn = document.querySelector(`button[onclick*="switchPayoutTab('${type}'"]`);
            // if(tabBtn) switchPayoutTab(type, tabBtn);

            document.getElementById('schedule-step-success').classList.remove('hidden');
        }, 1500);
    }

    function confirmDeleteSchedule(type) {
        state.pendingScheduleType = type;
        document.getElementById('modal-delete-payout').classList.remove('hidden');
    }

    function executeDeleteSchedule() {
        if (state.pendingScheduleType) {
            delete state.schedules[state.pendingScheduleType];
            renderSchedules();
            state.pendingScheduleType = null;
        }
        document.getElementById('modal-delete-payout').classList.add('hidden');
    }

    // Initial Render
    document.addEventListener('DOMContentLoaded', () => {
        updateDOMBalances();
        renderTransactions();
        renderSchedules();
    });

</script>
