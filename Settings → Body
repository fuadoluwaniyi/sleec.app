<div class="fixed inset-0 z-[100] flex items-center justify-center bg-on-surface/20 backdrop-blur-sm p-md hidden" id="password-modal"><div class="bg-surface-container-lowest rounded-2xl shadow-xl w-full max-w-md overflow-hidden border border-outline-variant/30"><div class="p-lg border-b border-outline-variant/20 flex justify-between items-center"><h3 class="font-headline-sm text-headline-sm">Change Password</h3><button class="material-symbols-outlined text-on-surface-variant" onclick="document.getElementById('password-modal').classList.add('hidden')">close</button></div><div class="p-lg space-y-md" id="password-flow-content"><div class="space-y-md" id="step-1"><p class="text-body-md text-on-surface-variant">Step 1: Verify your identity. Enter the 6-digit code sent to your email.</p><div class="flex flex-col gap-xs"><label class="text-label-sm font-semibold uppercase tracking-widest text-on-surface-variant">Verification Code</label><input class="bg-surface-container-low border border-outline-variant/50 rounded-lg px-md py-sm focus:outline-none focus:border-primary text-center text-headline-sm tracking-[1em]" id="verify-code-input" maxlength="6" placeholder="123456" type="text"/><p class="text-error text-label-sm hidden" id="verify-error">Incorrect verification code. Please try again.</p></div><button class="w-full h-10 bg-primary text-on-primary rounded-lg font-label-md shadow-md" onclick="const code = document.getElementById('verify-code-input').value; const err = document.getElementById('verify-error'); if(code === '123456'){ document.getElementById('step-1').classList.add('hidden'); document.getElementById('step-2').classList.remove('hidden'); err.classList.add('hidden'); } else { err.classList.remove('hidden'); }">Continue</button></div><div class="space-y-md hidden" id="step-2"><p class="text-body-md text-on-surface-variant">Step 2: Verify your current password.</p><div class="flex flex-col gap-xs"><label class="text-label-sm font-semibold uppercase tracking-widest text-on-surface-variant">Current Password</label><input class="bg-surface-container-low border border-outline-variant/50 rounded-lg px-md py-sm focus:outline-none focus:border-primary" id="current-pass-input" placeholder="sl" type="password"/><p class="text-error text-label-sm" id="current-pass-error">Current password is incorrect. Please try again.</p></div><button class="w-full h-10 bg-primary text-on-primary rounded-lg font-label-md shadow-md" onclick="const pass = document.getElementById('current-pass-input').value; const err = document.getElementById('current-pass-error'); if(pass === 'sleec'){ document.getElementById('step-2').classList.add('hidden'); document.getElementById('step-3').classList.remove('hidden'); err.classList.add('hidden'); } else { err.classList.remove('hidden'); }">Continue</button></div><div class="space-y-md hidden" id="step-3"><p class="text-body-md text-on-surface-variant">Step 3: Create your new password.</p><div class="flex flex-col gap-xs"><label class="text-label-sm font-semibold uppercase tracking-widest text-on-surface-variant">New Password</label><input class="bg-surface-container-low border border-outline-variant/50 rounded-lg px-md py-sm focus:outline-none focus:border-primary" id="new-pass" type="password"/></div><div class="flex flex-col gap-xs"><label class="text-label-sm font-semibold uppercase tracking-widest text-on-surface-variant">Confirm New Password</label><input class="bg-surface-container-low border border-outline-variant/50 rounded-lg px-md py-sm focus:outline-none focus:border-primary" id="confirm-pass" type="password"/><p class="text-error text-label-sm hidden" id="pass-error">Passwords do not match.</p></div><button class="w-full h-10 bg-primary text-on-primary rounded-lg font-label-md shadow-md" onclick="const p1 = document.getElementById('new-pass').value; const p2 = document.getElementById('confirm-pass').value; const err = document.getElementById('pass-error'); if(p1 &amp;&amp; p1 === p2){ document.getElementById('step-3').classList.add('hidden'); document.getElementById('step-4').classList.remove('hidden'); err.classList.add('hidden'); } else { err.classList.remove('hidden'); }">Save Changes</button></div><div class="py-xl text-center space-y-md hidden" id="step-4"><span class="material-symbols-outlined text-primary text-headline-xl">check_circle</span><h4 class="font-headline-sm text-on-surface">Password Changed Successfully</h4><p class="font-body-md text-on-surface-variant px-lg">Your password has been changed and saved successfully.</p><button class="px-lg h-10 bg-primary text-on-primary rounded-lg font-label-md shadow-md" onclick="document.getElementById('password-modal').classList.add('hidden');">Done</button></div></div></div></div>
<div class="fixed inset-0 z-[100] flex items-center justify-center bg-on-surface/20 backdrop-blur-sm p-md hidden" id="disable-2fa-modal-new"><div class="bg-surface-container-lowest rounded-2xl shadow-xl w-full max-w-md overflow-hidden border border-outline-variant/30"><div class="p-lg border-b border-outline-variant/20 flex justify-between items-center"><h3 class="font-headline-sm text-headline-sm">Disable Two-Factor Authentication</h3><button class="material-symbols-outlined text-on-surface-variant hover:text-on-surface transition-colors" onclick="document.getElementById('disable-2fa-modal-new').classList.add('hidden'); document.getElementById('disable-code-input').value=''; document.getElementById('disable-error').classList.add('hidden');">close</button></div><div class="p-lg space-y-md"><p class="text-body-md text-on-surface-variant">Disabling 2FA reduces your account security. Please verify your identity to continue.</p><div class="flex flex-col gap-xs"><label class="text-label-sm font-semibold uppercase tracking-widest text-on-surface-variant">Verification Code</label><input class="bg-surface-container-low border border-outline-variant/50 rounded-lg px-md py-sm focus:outline-none focus:border-primary text-center text-headline-sm tracking-[1em]" id="disable-code-input" maxlength="6" placeholder="123456" type="text"/><p class="text-error text-label-sm hidden" id="disable-error">Incorrect verification code. Please try again.</p></div><button class="w-full h-10 bg-error text-on-error rounded-lg font-label-md shadow-md" onclick="const code = document.getElementById('disable-code-input').value; if(code === '123456'){ window.is2FAEnabled = false; update2FAUI(); document.getElementById('disable-2fa-modal-new').classList.add('hidden'); document.getElementById('disable-code-input').value=''; document.getElementById('disable-error').classList.add('hidden'); showNotification('2FA disabled successfully'); } else { document.getElementById('disable-error').classList.remove('hidden'); }">Disable 2FA</button></div></div></div><div class="fixed inset-0 z-[100] flex items-center justify-center bg-on-surface/20 backdrop-blur-sm p-md hidden" id="enable-2fa-modal-new"><div class="bg-surface-container-lowest rounded-2xl shadow-xl w-full max-w-md overflow-hidden border border-outline-variant/30"><div class="p-lg border-b border-outline-variant/20 flex justify-between items-center"><h3 class="font-headline-sm text-headline-sm">Set up 2FA</h3><button class="material-symbols-outlined text-on-surface-variant hover:text-on-surface transition-colors" onclick="document.getElementById('enable-2fa-modal-new').classList.add('hidden')">close</button></div><div class="p-lg space-y-md" id="enable-flow-content"><div class="space-y-md" id="enable-step-1"><p class="text-body-md text-on-surface-variant">Add an extra layer of protection using an authenticator app (like Google Authenticator or Authy).</p><div class="flex flex-col items-center gap-md py-md bg-surface-container-low rounded-xl"><div class="w-32 h-32 bg-white border border-outline-variant/30 flex items-center justify-center"><span class="material-symbols-outlined text-outline-variant text-headline-xl">qr_code_2</span></div><p class="text-label-sm font-mono bg-surface-container px-md py-xs rounded">ABCD-EFGH-IJKL-MNOP</p></div><button class="w-full h-10 bg-primary text-on-primary rounded-lg font-label-md shadow-md" onclick="document.getElementById('enable-step-1').classList.add('hidden'); document.getElementById('enable-step-2').classList.remove('hidden');">Continue</button></div><div class="space-y-md hidden" id="enable-step-2"><p class="text-body-md text-on-surface-variant">Enter the 6-digit code from your authenticator app.</p><div class="flex flex-col gap-xs"><label class="text-label-sm font-semibold uppercase tracking-widest text-on-surface-variant">Authentication Code</label><input class="bg-surface-container-low border border-outline-variant/50 rounded-lg px-md py-sm focus:outline-none focus:border-primary text-center text-headline-sm tracking-[1em]" id="enable-code-input" maxlength="6" placeholder="123456" type="text"/><p class="text-error text-label-sm hidden" id="enable-error">Incorrect authentication code. Please try again.</p></div><button class="w-full h-10 bg-primary text-on-primary rounded-lg font-label-md shadow-md" onclick="const code = document.getElementById('enable-code-input').value; if(code === '123456'){ window.is2FAEnabled = true; update2FAUI(); document.getElementById('enable-2fa-modal-new').classList.add('hidden'); document.getElementById('enable-step-1').classList.remove('hidden'); document.getElementById('enable-step-2').classList.add('hidden'); document.getElementById('enable-code-input').value=''; document.getElementById('enable-error').classList.add('hidden'); showNotification('2FA enabled successfully'); } else { document.getElementById('enable-error').classList.remove('hidden'); }">Verify &amp; Enable</button></div></div></div></div><script>
